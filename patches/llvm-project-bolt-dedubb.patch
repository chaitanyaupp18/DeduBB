+namespace {
+
+//===----------------------------------------------------------------------===//
+// The finders, as in Step 1 (subsequence_dedupper.cc).
+//===----------------------------------------------------------------------===//
+
+struct KeyHash {
+  size_t operator()(std::string_view Key) const {
+    uint64_t Hash = 0xcbf29ce484222325ULL; // FNV-1a
+    for (char C : Key) {
+      Hash ^= static_cast<uint8_t>(C);
+      Hash *= 0x100000001b3ULL;
+    }
+    return static_cast<size_t>(Hash);
+  }
+};
+
+// Marks the `push` and `lea` of a Call-Return stub whose master makes calls,
+// with how much each moves the CFA, until DeduBBCFI turns it into CFI.
+constexpr const char *CFAAdjustAnnotation = "DeduBBCFAAdjust";
+
+// Which kinds of range may hold an instruction.
+enum RunKind : uint8_t {
+  RunCallReturn = 1,
+  RunSaveAndJump = 2,
+};
+
+// The program's instructions, block after block (Step 1's SubsequenceInput).
+struct Input {
+  struct Block {
+    uint64_t Address = 0;
+    uint64_t Frequency = 0;
+    bool LLVMSuffix = false; // The function's name has a ThinLTO ".llvm.".
+    uint32_t FirstInst = 0;
+    uint32_t NumInsts = 0;
+  };
+
+  void addBlock(uint64_t Address, uint64_t Frequency, bool LLVMSuffix) {
+    Blocks.push_back({Address, Frequency, LLVMSuffix,
+                      static_cast<uint32_t>(Sizes.size()), 0});
+  }
+
+  // `Kinds` is 0, and `Key` empty, for an instruction no fold may hold.
+  void addInstruction(std::string_view Key, unsigned Size, uint8_t Kinds,
+                      bool Call) {
+    if (Key.empty())
+      Kinds = 0;
+    if (Kinds)
+      KeyBytes.append(Key);
+    KeyBegin.push_back(KeyBytes.size());
+    Sizes.push_back(static_cast<uint8_t>(std::min(Size, 255u)));
+    KindBits.push_back(Kinds);
+    Calls.push_back(Call);
+    ++Blocks.back().NumInsts;
+  }
+
+  size_t numInstructions() const { return Sizes.size(); }
+  std::string_view key(size_t I) const {
+    return std::string_view(KeyBytes).substr(KeyBegin[I],
+                                             KeyBegin[I + 1] - KeyBegin[I]);
+  }
+
+  std::vector<Block> Blocks;
+  std::vector<uint64_t> KeyBegin{0};
+  std::string KeyBytes;
+  std::vector<uint8_t> Sizes;
+  std::vector<uint8_t> KindBits;
+  std::vector<bool> Calls;
+};
+
+// The order blocks are preferred in as masters: the hottest first, then one
+// whose function has no ThinLTO ".llvm." suffix, then the lowest address.
+bool blockLess(const Input::Block &X, const Input::Block &Y) {
+  if (X.Frequency != Y.Frequency)
+    return X.Frequency > Y.Frequency;
+  if (X.LLVMSuffix != Y.LLVMSuffix)
+    return !X.LLVMSuffix;
+  return X.Address < Y.Address;
+}
+
+constexpr uint32_t Barrier = std::numeric_limits<uint32_t>::max();
+
+std::vector<int32_t> buildSuffixArray(const std::vector<int32_t> &Text,
+                                      int32_t Alphabet) {
+  const int32_t N = static_cast<int32_t>(Text.size());
+  std::vector<int32_t> SA(N), Rank(N), Tmp(N);
+  if (N == 0)
+    return SA;
+  // Prefix doubling, two stable counting sorts per round.
+  {
+    std::vector<int32_t> Count(static_cast<size_t>(Alphabet) + 1, 0);
+    for (int32_t C : Text)
+      ++Count[C + 1];
+    for (size_t C = 1; C < Count.size(); ++C)
+      Count[C] += Count[C - 1];
+    for (int32_t I = 0; I < N; ++I)
+      SA[Count[Text[I]]++] = I;
+  }
+  int32_t Classes = 1;
+  Rank[SA[0]] = 0;
+  for (int32_t J = 1; J < N; ++J) {
+    if (Text[SA[J]] != Text[SA[J - 1]])
+      ++Classes;
+    Rank[SA[J]] = Classes - 1;
+  }
+  std::vector<int32_t> Count(static_cast<size_t>(N) + 1);
+  for (int64_t K = 1; Classes < N; K <<= 1) {
+    int32_t P = 0;
+    for (int64_t I = std::max<int64_t>(0, N - K); I < N; ++I)
+      Tmp[P++] = static_cast<int32_t>(I);
+    for (int32_t J = 0; J < N; ++J)
+      if (SA[J] >= K)
+        Tmp[P++] = static_cast<int32_t>(SA[J] - K);
+    std::fill(Count.begin(), Count.begin() + Classes + 1, 0);
+    for (int32_t I = 0; I < N; ++I)
+      ++Count[Rank[I] + 1];
+    for (int32_t C = 1; C <= Classes; ++C)
+      Count[C] += Count[C - 1];
+    for (int32_t J = 0; J < N; ++J)
+      SA[Count[Rank[Tmp[J]]]++] = Tmp[J];
+    int32_t NextClasses = 1;
+    Tmp[SA[0]] = 0;
+    for (int32_t J = 1; J < N; ++J) {
+      const int32_t A = SA[J - 1], B = SA[J];
+      const int32_t A2 = A + K < N ? Rank[A + K] : -1;
+      const int32_t B2 = B + K < N ? Rank[B + K] : -1;
+      if (Rank[A] != Rank[B] || A2 != B2)
+        ++NextClasses;
+      Tmp[B] = NextClasses - 1;
+    }
+    Rank.swap(Tmp);
+    Classes = NextClasses;
+  }
+  return SA;
+}
+
+std::vector<int32_t> buildLcpArray(const std::vector<int32_t> &Text,
+                                   const std::vector<int32_t> &SA) {
+  // Kasai et al.
+  const int32_t N = static_cast<int32_t>(Text.size());
+  std::vector<int32_t> Rank(N), Lcp(N, 0);
+  for (int32_t I = 0; I < N; ++I)
+    Rank[SA[I]] = I;
+  int32_t H = 0;
+  for (int32_t I = 0; I < N; ++I) {
+    if (Rank[I] == 0) {
+      H = 0;
+      continue;
+    }
+    const int32_t J = SA[Rank[I] - 1];
+    while (I + H < N && J + H < N && Text[I + H] == Text[J + H])
+      ++H;
+    Lcp[Rank[I]] = H;
+    if (H > 0)
+      --H;
+  }
+  return Lcp;
+}
+
+struct RunOptions {
+  int StubSize = 5;           // call rel32
+  int StubSizeWithCalls = 11; // push %rax; call rel32; lea 8(%rsp),%rsp
+  int MasterOverhead = 1;     // ret
+  int SJStubSize = 12;        // lea 1f(%rip),%r11; jmp rel32
+  int SJMasterOverhead = 3;   // jmp *%r11
+  int MinOccurrences = 2;
+};
+
+struct RunResult {
+  struct Group {
+    uint32_t Length = 0;
+    uint32_t Bytes = 0;
+    bool WithCalls = false;
+    RunKind Kind = RunCallReturn;
+    int64_t Benefit = 0;
