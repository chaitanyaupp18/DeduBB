+//===- bolt/Passes/DeduBB.h - Basic block deduplication ---------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// DeduBB folds machine code that repeats anywhere in the binary into one copy,
+// the master: tail-call endings shared in place, and runs of instructions
+// moved into Call-Return or Save-and-Jump masters. See DeduBB.cpp.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef BOLT_PASSES_DEDUBB_H
+#define BOLT_PASSES_DEDUBB_H
+
+#include "bolt/Passes/BinaryPasses.h"
+
+namespace llvm {
+namespace bolt {
+
+class DeduBB : public BinaryFunctionPass {
+public:
+  explicit DeduBB(const cl::opt<bool> &PrintPass)
+      : BinaryFunctionPass(PrintPass) {}
+
+  const char *getName() const override { return "dedubb"; }
+
+  Error runOnFunctions(BinaryContext &BC) override;
+};
+
+/// Adds the CFI of the Call-Return stubs whose masters make calls, once
+/// FinalizeFunctions has fixed each function's CFI for its final layout.
+class DeduBBCFI : public BinaryFunctionPass {
+public:
+  explicit DeduBBCFI(const cl::opt<bool> &PrintPass)
+      : BinaryFunctionPass(PrintPass) {}
+
+  const char *getName() const override { return "dedubb-cfi"; }
+
+  Error runOnFunctions(BinaryContext &BC) override;
+};
+
+} // namespace bolt
+} // namespace llvm
+
+#endif
diff --git a/bolt/lib/Passes/DeduBB.cpp b/bolt/lib/Passes/DeduBB.cpp
new file mode 100644
index 000000000000..d54a35563b90
--- /dev/null
+++ b/bolt/lib/Passes/DeduBB.cpp
@@ -0,0 +1,2018 @@
+//===- bolt/Passes/DeduBB.cpp - Basic block deduplication -----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// DeduBB in BOLT: the folds of the Propeller + CodeGen implementation (Step 1,
+// llvm-propeller's subsequence_dedupper.cc and tail_call_profile_writer.cc;
+// Step 2, llvm/lib/CodeGen/DeduBBCallReturn.cpp), found and applied in one
+// pass over the linked binary (x86-64, relocation mode):
+//
+//  * Tail-call endings. A block that ends in a return or a tail call keeps
+//    its first instructions and replaces the last ones with a jump into a
+//    master block that ends the same way, at an entry point placed where the
+//    shared ending starts:
+//
+//      fold:   <before>                    master:  <its own>
+//              jmp <ending>                <ending>: <the shared instructions>
+//
+//    The jump keeps the fold's frame, so the ending may restore registers and
+//    pop the frame. It holds no call but a final tail call: nothing unwinds
+//    through it with the rules of the master's function.
+//
+//  * Call-Return runs. Every copy of a run becomes `call <master>`, where the
+//    master, in DeduBB.cr.masters, is the run and then `ret`. The run must not
+//    touch %rsp, %rip or the shadow-stack pointer, and its function must not
+//    keep data in the red zone, where the call writes. A run may make calls:
+//    plain direct calls, and calls through a register or memory. Its copies
+//    then become
+//
+//      push %rax; call <master>; lea 8(%rsp), %rsp
+//
+//    so that the master's calls see the stack aligned as the block's did,
+//    with `.cfi_adjust_cfa_offset` around the call where the CFA is
+//    %rsp-based. None of the calls may take arguments on the stack, which
+//    would be 16 bytes away from where its callee looks for them: CodeGen
+//    checks the frame's MaxCallFrameSize; here a call qualifies if nothing
+//    that may write 0(%rsp), where its first stack argument would be, reaches
+//    it since the call before (findStackArgCalls). None may have a landing
+//    pad either, as no invoke is in a run in CodeGen; a copy's stub takes
+//    over its calls' entry in the call-site table.
+//
+//  * Save-and-Jump runs. Every copy becomes
+//
+//      lea Tail(%rip), %r11; jmp <master>; Tail: <the rest of the block>
+//
+//    where the master, in DeduBB.sj.masters, is the run and then `jmp *%r11`.
+//    It runs in the block's own frame, so the run may read and write the
+//    block's stack slots, but may not move %rsp, call, branch or touch %r11,
+//    which must be dead where the run starts. DeduBB.sj.masters has no unwind
+//    info: no rule of its own describes the frames it runs in.
+//
+// The folds are found as Step 1 finds them. Tail-call endings first: the
+// endings of the blocks that end in a return or a tail call form a trie, read
+// from the end, and every block folds the longest ending it shares with a
+// master block, if that saves bytes. Then the runs, in the rest of every
+// block: the program is one string of tokens, one per instruction, with a
+// barrier for every instruction no master can run (and for every CFI
+// instruction, which a run may not cross); the repeated substrings are the
+// intervals of its suffix and LCP arrays, costed in bytes and taken greedily.
+// Two instructions get the same token if they have the same bytes; a direct
+// tail jump is keyed by the function (and entry) it reaches. An operand BOLT
+// symbolized for any other reason (a %rip-relative or absolute address) makes
+// the instruction one no master can run.
+//
+// Step 1 decides from bytes and Step 2 checks what bytes cannot tell; here
+// Step 2's checks (the frame setup a run must start after, %r11's liveness,
+// landing pads, stack arguments) run before the folds are chosen.
+//
+//===----------------------------------------------------------------------===//
+
