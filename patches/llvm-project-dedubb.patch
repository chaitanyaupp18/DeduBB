+#include <string>
+
+using namespace llvm;
+
+#define DEBUG_TYPE "dedubb"
+
+// Always enabled, so `-mllvm -stats` reports how many directives were applied,
+// and why the rest were not, in release builds too.
+ALWAYS_ENABLED_STATISTIC(NumTailCallFolds, "Number of tail-call blocks folded");
+ALWAYS_ENABLED_STATISTIC(
+    NumTailCallSkipSymbols,
+    "Number of tail-call folds skipped: the block names a symbol other than "
+    "the calls and jumps its directive lists");
+ALWAYS_ENABLED_STATISTIC(
+    NumTailCallSkipSuccessors,
+    "Number of tail-call folds skipped: the block has a successor");
+ALWAYS_ENABLED_STATISTIC(NumSJFolds, "Number of Save-and-Jump blocks folded");
+ALWAYS_ENABLED_STATISTIC(NumSJMastersInPlace,
+                         "Number of Save-and-Jump masters rewritten in place");
+ALWAYS_ENABLED_STATISTIC(
+    NumSJMastersCopied,
+    "Number of Save-and-Jump masters emitted as an out-of-line copy");
+ALWAYS_ENABLED_STATISTIC(NumSJ2Folds,
+                         "Number of two-exit Save-and-Jump blocks folded");
+ALWAYS_ENABLED_STATISTIC(
+    NumSJ2MastersInPlace,
+    "Number of two-exit Save-and-Jump masters rewritten in place");
+ALWAYS_ENABLED_STATISTIC(
+    NumSJ2MastersCopied,
+    "Number of two-exit Save-and-Jump masters emitted as a copy");
+ALWAYS_ENABLED_STATISTIC(
+    NumSJIneligible,
+    "Number of Save-and-Jump directives skipped: block not eligible");
+ALWAYS_ENABLED_STATISTIC(
+    NumSJLinkRegLive,
+    "Number of Save-and-Jump blocks left as is: the link register (R11 on "
+    "x86-64) is live into a successor");
+ALWAYS_ENABLED_STATISTIC(
+    NumSJ2SecondLinkRegLive,
+    "Number of two-exit Save-and-Jump blocks left as is: the second link "
+    "register (R10 on x86-64) is live into a successor");
+ALWAYS_ENABLED_STATISTIC(
+    NumSJBadExit,
+    "Number of Save-and-Jump blocks left as is: a successor is the block "
+    "itself or an EH pad");
+ALWAYS_ENABLED_STATISTIC(
+    NumSJNotReplaceable,
+    "Number of Save-and-Jump folds skipped: CFI, frame, EH or asm code");
+
+static cl::opt<std::string> DeduBBDirectivesFile(
+    "dedubb-directives", cl::Hidden, cl::init(""),
+    cl::desc("Path to a DeduBB tail-call deduplication directive file "
+             "(m/f/bbm/bbf directives) to apply during code generation."));
+
+//===----------------------------------------------------------------------===//
+// Directive file parsing.
+//===----------------------------------------------------------------------===//
+
+// Parses the master id K out of a "(DeduBB.master.K)", "(DeduBB.master.sj.K)",
+// "(DeduBB.master.sj2.K)" or "(DeduBB.master.cr.K)" token.
+static bool parseMasterID(StringRef S, uint64_t &K) {
+  constexpr StringRef kPrefix = "DeduBB.master.";
+  size_t Pos = S.find(kPrefix);
+  if (Pos == StringRef::npos)
+    return false;
+  StringRef Rest = S.substr(Pos + kPrefix.size());
+  if (Rest.starts_with("sj2."))
+    Rest = Rest.substr(4);
+  else if (Rest.starts_with("sj."))
+    Rest = Rest.substr(3);
+  else if (Rest.starts_with("cr."))
+    Rest = Rest.substr(3);
+  size_t End = 0;
+  while (End < Rest.size() && Rest[End] >= '0' && Rest[End] <= '9')
+    ++End;
+  return End != 0 && !Rest.substr(0, End).getAsInteger(10, K);
+}
+
+// Returns the value of `<Key>=<value>` among the space-separated \p Fields.
+static std::optional<StringRef> getField(StringRef Fields, StringRef Key) {
+  SmallVector<StringRef, 8> Parts;
+  Fields.split(Parts, ' ', /*MaxSplit=*/-1, /*KeepEmpty=*/false);
+  for (StringRef Part : Parts)
+    if (Part.consume_front(Key) && Part.consume_front("="))
+      return Part;
+  return std::nullopt;
+}
+
+// Reads the `callees=`, `insts=` and, for a master, `body=` fields of a
+// Call-Return directive. The callees and the instruction count are checked
+// against every block, and the master is emitted from the body, so all are
+// required; the body must hold one piece of hex more than there are direct
+// callees.
+static bool parseCallReturn(StringRef Fields, bool IsMaster,
+                            DeduBBDirectives::Directive &D) {
+  std::optional<StringRef> Callees = getField(Fields, "callees");
+  std::optional<StringRef> Insts = getField(Fields, "insts");
+  if (!Callees || !Insts || Insts->getAsInteger(10, D.NumInsts) ||
+      D.NumInsts == 0)
+    return false;
+  D.Callees = Callees->str();
+  if (!IsMaster)
+    return true;
+  std::optional<StringRef> Body = getField(Fields, "body");
+  if (!Body || Body->empty())
+    return false;
+  SmallVector<StringRef, 4> Calls, Pieces;
+  if (!Callees->empty())
+    Callees->split(Calls, ',');
+  Body->split(Pieces, '.');
+  const size_t DirectCalls =
+      count_if(Calls, [](StringRef C) { return C != "*"; });
+  if (Pieces.size() != 1 + DirectCalls)
+    return false;
+  for (StringRef Piece : Pieces)
+    if (Piece.size() % 2 != 0 || !all_of(Piece, isHexDigit))
+      return false;
+  D.Body = Body->str();
+  return true;
+}
+
+bool DeduBBDirectives::parse(StringRef Text) {
+  StringRef CurFunc;
+  bool Ok = true;
+  // Reports the first few bad lines; a file from another version of Step 1
+  // could have a bad line for every block.
+  unsigned NumErrors = 0, NumBadCallReturn = 0;
+  const auto Error = [&](const Twine &Msg) {
+    if (++NumErrors <= 10)
+      errs() << "dedubb: " << Msg << "\n";
+    Ok = false;
+  };
+  SmallVector<StringRef> Lines;
+  Text.split(Lines, '\n');
+  for (StringRef Line : Lines) {
+    Line = Line.trim();
+    if (Line.empty() || Line.starts_with("#"))
+      continue;
+    auto [Kw, Rest] = Line.split(' ');
+    Rest = Rest.trim();
+    if (Kw == "m") {
+      // Module header. Matching is by function name, so this is informational.
+      continue;
+    }
+    if (Kw == "f") {
+      CurFunc = Rest.split(".llvm.").first;
+      continue;
+    }
+    if (Kw == "bbm" || Kw == "bbf" || Kw == "bbmsj" || Kw == "bbfsj" ||
+        Kw == "bbmsj2" || Kw == "bbfsj2" || Kw == "bbmcr" || Kw == "bbfcr") {
+      if (CurFunc.empty()) {
+        Error("directive before any 'f' line: '" + Line + "'");
+        continue;
+      }
+      auto [IdStr, Tail] = Rest.split(' ');
+      unsigned BBID;
+      uint64_t K;
+      if (IdStr.getAsInteger(10, BBID) || !parseMasterID(Tail, K)) {
+        Error("malformed directive: '" + Line + "'");
+        continue;
+      }
+      DeduBBDirectives::Kind DK;
+      if (Kw == "bbm") DK = DeduBBDirectives::Master;
+      else if (Kw == "bbf") DK = DeduBBDirectives::Fold;
+      else if (Kw == "bbmsj") DK = DeduBBDirectives::MasterSaveJump;
+      else if (Kw == "bbfsj") DK = DeduBBDirectives::FoldSaveJump;
+      else if (Kw == "bbmsj2") DK = DeduBBDirectives::MasterSaveJump2;
+      else if (Kw == "bbfsj2") DK = DeduBBDirectives::FoldSaveJump2;
+      else if (Kw == "bbmcr") DK = DeduBBDirectives::MasterCallReturn;
+      else DK = DeduBBDirectives::FoldCallReturn;
+
+      Directive D{DK, K};
+      if (DK == DeduBBDirectives::Master || DK == DeduBBDirectives::Fold)
+        if (std::optional<StringRef> Callees = getField(Tail, "callees"))
+          D.Callees = Callees->str();
+      if (DK == DeduBBDirectives::MasterCallReturn ||
+          DK == DeduBBDirectives::FoldCallReturn) {
+        if (!parseCallReturn(Tail, DK == DeduBBDirectives::MasterCallReturn,
+                             D)) {
+          Error("malformed Call-Return directive: '" + Line + "'");
+          ++NumBadCallReturn;
+          continue;
+        }
+        HasCallReturn = true;
+      }
+      Map[CurFunc][BBID] = std::move(D);
+      continue;
+    }
+    Error("unknown directive '" + Kw + "'");
+  }
+  if (NumErrors > 10)
+    errs() << "dedubb: " << NumErrors - 10 << " more bad line(s)\n";
+  // A group whose master was dropped would leave its other blocks calling a
+  // master nobody defines, so one bad Call-Return line drops them all.
+  if (NumBadCallReturn != 0) {
+    errs() << "dedubb: " << NumBadCallReturn
+           << " malformed Call-Return directive(s): ignoring every Call-Return "
+              "directive\n";
+    for (auto &Func : Map)
+      for (auto It = Func.second.begin(); It != Func.second.end();) {
+        auto Next = std::next(It);
+        if (It->second.K == MasterCallReturn || It->second.K == FoldCallReturn)
+          Func.second.erase(It);
+        It = Next;
+      }
+    HasCallReturn = false;
+  }
+  return Ok;
+}
+
+const DeduBBDirectives::Directive *
+DeduBBDirectives::lookup(StringRef FuncName, unsigned BBID) const {
+  auto It = Map.find(FuncName.split(".llvm.").first);
+  if (It == Map.end())
+    return nullptr;
+  auto J = It->second.find(BBID);
+  return J == It->second.end() ? nullptr : &J->second;
+}
+
+const DeduBBDirectives::Directive *
+DeduBBDirectives::lookup(const Function &F, unsigned BBID) const {
+  if (const Directive *D = lookup(F.getName(), BBID))
+    return D;
+  for (const GlobalAlias &A : F.getParent()->aliases())
+    if (A.getAliaseeObject() == &F)
+      if (const Directive *D = lookup(A.getName(), BBID))
+        return D;
+  return nullptr;
+}
+
+const DenseMap<unsigned, DeduBBDirectives::Directive> *
+DeduBBDirectives::getFunction(const Function &F) const {
+  auto It = Map.find(F.getName().split(".llvm.").first);
+  if (It != Map.end())
+    return &It->second;
+  for (const GlobalAlias &A : F.getParent()->aliases())
+    if (A.getAliaseeObject() == &F) {
+      It = Map.find(A.getName().split(".llvm.").first);
+      if (It != Map.end())
+        return &It->second;
+    }
+  return nullptr;
+}
+
+bool DeduBBDirectives::hasSaveJump(StringRef FuncName) const {
+  auto It = Map.find(FuncName.split(".llvm.").first);
+  if (It == Map.end())
+    return false;
+  for (const auto &Entry : It->second) {
+    Kind K = Entry.second.K;
+    if (K == MasterSaveJump || K == FoldSaveJump || K == MasterSaveJump2 ||
+        K == FoldSaveJump2)
+      return true;
+  }
+  return false;
+}
+
+bool DeduBBDirectives::calleesMatch(StringRef Listed,
+                                    ArrayRef<std::string> Actual) {
+  SmallVector<StringRef, 4> Calls;
+  if (!Listed.empty())
+    Listed.split(Calls, ',');
+  if (Calls.size() != Actual.size())
+    return false;
+  for (auto [Names, Name] : zip_equal(Calls, Actual)) {
+    SmallVector<StringRef, 4> Alternatives;
+    Names.split(Alternatives, '|');
+    if (!is_contained(Alternatives, StringRef(Name)))
+      return false;
+  }
+  return true;
+}
+
+std::string DeduBBDirectives::getCalleeName(const MachineOperand &MO) {
+  if (MO.isGlobal()) {
+    StringRef Name = MO.getGlobal()->getName();
+    Name.consume_front("\1");
+    return Name.str();
+  }
+  if (MO.isSymbol())
+    return MO.getSymbolName();
+  return MO.getMCSymbol()->getName().str();
+}
+
+const DeduBBDirectives &DeduBBDirectives::get() {
+  static DeduBBDirectives Directives;
+  static bool Initialized = [] {
+    if (DeduBBDirectivesFile.empty())
+      return true;
+    ErrorOr<std::unique_ptr<MemoryBuffer>> Buf =
+        MemoryBuffer::getFile(DeduBBDirectivesFile);
+    if (!Buf) {
+      errs() << "dedubb: cannot open directive file '" << DeduBBDirectivesFile
+             << "': " << Buf.getError().message() << "\n";
+      return true;
+    }
+    Directives.parse((*Buf)->getBuffer());
+    return true;
+  }();
+  (void)Initialized;
+  return Directives;
+}
+
+//===----------------------------------------------------------------------===//
+// Save-and-Jump helpers.
+//===----------------------------------------------------------------------===//
+
+// Where control leaves a Save-and-Jump block. Exits[0] is the only successor of
+// a single-exit block, or the target of a two-exit block's conditional branch;
+// Exits[1] is a two-exit block's other successor (its fall-through or the
+// target of its unconditional branch).
+struct SaveJumpExits {
+  SmallVector<MachineBasicBlock *, 2> Exits;
+  SmallVector<MachineOperand, 4> Cond; // The conditional branch's condition.
+};
+
+// Reads the exits of \p MBB if its terminators have the Save-and-Jump shape.
+// Single-exit: a fall-through or one unconditional branch to its only
+// successor. Two-exit: one conditional branch, then a fall-through or one
+// unconditional branch, to two distinct successors; conditions that expand to
+// two conditional branches (such as X86's COND_NE_OR_P) are refused. The shape
+// is encoded in the block's bytes, so every member of a group of byte-identical
+// blocks agrees on it.
+static bool getSaveJumpExits(MachineBasicBlock &MBB, const TargetInstrInfo &TII,
+                             bool TwoExit, SaveJumpExits &X) {
+  MachineBasicBlock *TBB = nullptr, *FBB = nullptr;
+  SmallVector<MachineOperand, 4> Cond;
+  if (TII.analyzeBranch(MBB, TBB, FBB, Cond, /*AllowModify=*/false))
+    return false;
+  unsigned NumCond = 0, NumUncond = 0;
+  for (const MachineInstr &MI : MBB.terminators()) {
+    if (MI.isDebugInstr())
+      continue;
+    if (MI.isConditionalBranch())
+      ++NumCond;
+    else if (MI.isUnconditionalBranch())
+      ++NumUncond;
+    else
+      return false;
+  }
+  if (NumCond != (TwoExit ? 1u : 0u) || NumUncond > 1)
+    return false;
+
+  X.Exits.clear();
+  X.Cond.clear();
+  if (!TwoExit) {
+    if (!Cond.empty() || FBB || MBB.succ_size() != 1)
+      return false;
+    MachineBasicBlock *Succ = *MBB.succ_begin();
+    if (TBB ? TBB != Succ : MBB.getFallThrough() != Succ)
+      return false;
+    X.Exits.push_back(Succ);
+    return true;
+  }
+  if (Cond.empty() || !TBB)
+    return false;
+  if (!FBB)
+    FBB = MBB.getFallThrough();
+  if (!FBB || FBB == TBB || MBB.succ_size() != 2 || !MBB.isSuccessor(TBB) ||
+      !MBB.isSuccessor(FBB))
+    return false;
+  X.Exits.push_back(TBB);
+  X.Exits.push_back(FBB);
+  X.Cond = std::move(Cond);
+  return true;
+}
+
+// Returns true if \p MBB's body, everything before its terminators, can run in
+// any folded function's frame:
+//   * no calls, since a call clobbers the link registers;
+//   * no read or write of the link registers \p LinkRegs;
+//   * no symbolic, block-address or jump-table operands, whose bytes depend on
+//     where the block is placed.
+// Like the exit shape, these are encoded in the instruction bytes, so a fold is
+// only ever emitted against a master that its own function also emits.
+static bool isSaveJumpBody(const MachineBasicBlock &MBB,
+                           const TargetRegisterInfo &TRI,
+                           ArrayRef<MCRegister> LinkRegs) {
+  for (const MachineInstr &MI : MBB) {
+    if (MI.isDebugInstr() || MI.isTerminator())
+      continue; // The terminators were checked by getSaveJumpExits.
+    if (MI.isCall())
+      return false;
+    for (MCRegister Reg : LinkRegs)
+      if (MI.readsRegister(Reg, &TRI) || MI.modifiesRegister(Reg, &TRI))
+        return false;
+    for (const MachineOperand &MO : MI.operands())
+      if (MO.isRegMask() || MO.isGlobal() || MO.isSymbol() || MO.isCPI() ||
+          MO.isJTI() || MO.isBlockAddress() || MO.isMCSymbol() || MO.isMBB() ||
+          MO.isTargetIndex())
+        return false;
+  }
+  return true;
+}
+
+// Why a block with the Save-and-Jump shape still cannot be folded where it is.
+enum class SiteProblem {
+  None,
+  BadExit,           // An exit is the block itself or an EH pad.
+  LinkRegLive,       // LinkRegs[0] is live into an exit.
+  SecondLinkRegLive, // LinkRegs[1] is live into an exit.
+};
+
+// Checks the exits of \p MBB: each must be another, non-EH-pad block, and no
+// link register may be live on entry to it, since the fold overwrites them
+// with return addresses. The block itself never touches the link registers
+// (isSaveJumpBody), so a value still needed in one would be live into an exit.
+static SiteProblem checkSite(const MachineBasicBlock &MBB,
+                             ArrayRef<MachineBasicBlock *> Exits,
+                             const TargetRegisterInfo &TRI,
+                             ArrayRef<MCRegister> LinkRegs) {
+  for (const MachineBasicBlock *Exit : Exits) {
+    if (Exit == &MBB || Exit->isEHPad())
+      return SiteProblem::BadExit;
+    LiveRegUnits LiveIn(TRI);
+    LiveIn.addLiveIns(*Exit);
+    for (auto [I, Reg] : enumerate(LinkRegs))
+      if (!LiveIn.available(Reg))
+        return I == 0 ? SiteProblem::LinkRegLive
+                      : SiteProblem::SecondLinkRegLive;
+  }
+  return SiteProblem::None;
+}
+
+// Returns true if \p MBB's body may be replaced by a stub. Blocks holding CFI,
+// prologue/epilogue code, labels, inline asm or an EH pad are left alone:
+// deleting them would break the function's unwind info or EH tables.
+static bool isReplaceable(const MachineBasicBlock &MBB) {
+  if (MBB.isEHPad())
+    return false;
+  for (const MachineInstr &MI : MBB)
+    if (MI.isCFIInstruction() || MI.isLabel() || MI.isInlineAsm() ||
+        MI.getFlag(MachineInstr::FrameSetup) ||
+        MI.getFlag(MachineInstr::FrameDestroy))
+      return false;
+  return true;
+}
+
+// The master can stay in place only if every way into it can be redirected
+// through a block that loads its own return address first.
+static bool canRewriteMasterInPlace(const MachineBasicBlock &MBB) {
+  return !MBB.isEntryBlock() && !MBB.hasAddressTaken() &&
+         !MBB.isInlineAsmBrIndirectTarget() && !MBB.isEHPad();
+}
+
+// Places the global `DeduBB.master.sj.K` label at the start of \p MBB. The
+// AsmPrinter gives it global, hidden binding.
+static void addMasterLabel(MachineBasicBlock &MBB, StringRef MasterSym,
+                           const TargetInstrInfo &TII) {
+  MCSymbol *Sym = MBB.getParent()->getContext().getOrCreateSymbol(MasterSym);
+  BuildMI(MBB, MBB.begin(), DebugLoc(), TII.get(TargetOpcode::ANNOTATION_LABEL))
+      .addSym(Sym);
+}
+
+// Replaces \p MBB's body with the fold stub: load each exit's address into its
+// link register, then jump to the master. The CFG edges to the exits stay,
+// since control reaches them again through the master.
+static void emitSaveJumpFold(MachineBasicBlock &MBB,
+                             ArrayRef<MachineBasicBlock *> Exits,
+                             ArrayRef<MCRegister> LinkRegs, StringRef MasterSym,
+                             const TargetInstrInfo &TII) {
+  MBB.erase(MBB.begin(), MBB.end());
+  for (auto [Exit, Reg] : zip_equal(Exits, LinkRegs)) {
+    TII.insertDeduBBLoadReturnAddress(MBB, *Exit, Reg);
+    Exit->setLabelMustBeEmitted();
+  }
+  TII.insertDeduBBTailBranch(MBB, MasterSym);
+}
+
+// Ends \p MBB, whose terminators have been removed, with the master's return.
+// Single exit: `jmp *LinkRegs[0]` in \p MBB itself. Two exits:
+//
+//       j<Cond> RetTaken
+//     RetNotTaken:  jmp *LinkRegs[1]
+//     RetTaken:     jmp *LinkRegs[0]
+//
+// with both return blocks placed right after \p MBB. Returns the blocks that
+// hold the returns, in exit order.
+static SmallVector<MachineBasicBlock *, 2>
+emitMasterReturn(MachineBasicBlock &MBB, ArrayRef<MCRegister> LinkRegs,
+                 ArrayRef<MachineOperand> Cond, const TargetInstrInfo &TII) {
+  if (LinkRegs.size() == 1) {
+    TII.insertDeduBBSaveAndJumpReturn(MBB, LinkRegs[0]);
+    return {&MBB};
+  }
+  MachineFunction &MF = *MBB.getParent();
+  MachineBasicBlock *RetNotTaken = MF.CreateMachineBasicBlock();
+  MachineBasicBlock *RetTaken = MF.CreateMachineBasicBlock();
+  MF.insert(std::next(MBB.getIterator()), RetNotTaken);
+  MF.insert(std::next(RetNotTaken->getIterator()), RetTaken);
+  TII.insertBranch(MBB, RetTaken, /*FBB=*/nullptr, Cond, DebugLoc());
+  TII.insertDeduBBSaveAndJumpReturn(*RetNotTaken, LinkRegs[1]);
+  TII.insertDeduBBSaveAndJumpReturn(*RetTaken, LinkRegs[0]);
+  RetTaken->addLiveIn(LinkRegs[0]);
+  RetNotTaken->addLiveIn(LinkRegs[1]);
+  return {RetTaken, RetNotTaken};
+}
+
+//===----------------------------------------------------------------------===//
+// The pass.
+//===----------------------------------------------------------------------===//
+
+namespace {
+class DeduBB : public MachineFunctionPass {
+public:
+  static char ID;
+  DeduBB() : MachineFunctionPass(ID) {
+    initializeDeduBBPass(*PassRegistry::getPassRegistry());
+  }
+  StringRef getPassName() const override {
+    return "DeduBB tail-call deduplication";
+  }
+  bool runOnMachineFunction(MachineFunction &MF) override;
+
+private:
+  bool applySaveAndJump(MachineFunction &MF,
+                        ArrayRef<std::pair<MachineBasicBlock *,
+                                           const DeduBBDirectives::Directive *>>
+                            Items);
+};
+} // namespace
+
+char DeduBB::ID = 0;
+INITIALIZE_PASS(DeduBB, DEBUG_TYPE, "DeduBB tail-call deduplication",
+                /*cfg=*/false, /*is_analysis=*/false)
+
+bool DeduBB::applySaveAndJump(
+    MachineFunction &MF,
+    ArrayRef<std::pair<MachineBasicBlock *, const DeduBBDirectives::Directive *>>
+        Items) {
+  const TargetInstrInfo &TII = *MF.getSubtarget().getInstrInfo();
+  const TargetRegisterInfo &TRI = *MF.getSubtarget().getRegisterInfo();
+  const MCRegister Link = TII.getDeduBBLinkRegister();
+  const MCRegister Link2 = TII.getDeduBBSecondLinkRegister();
+  if (!Link.isValid())
+    return false;
+
+  // Decide everything on the untouched function first, so eligibility matches
+  // the byte-identical blocks the profile was computed from.
+  struct Work {
+    MachineBasicBlock *MBB;
+    bool IsMaster;
+    bool TwoExit;
+    // Whether the block's own exits allow a fold here (checkSite).
+    SiteProblem Site;
+    bool InPlace;
+    SmallVector<MCRegister, 2> LinkRegs; // One per exit, in exit order.
+    SmallVector<MachineOperand, 4> Cond; // Two-exit only.
+    std::string Sym;
+  };
+  SmallVector<Work, 8> Todo;
+  for (auto [MBB, D] : Items) {
+    Work W;
+    W.MBB = MBB;
+    W.IsMaster = D->K == DeduBBDirectives::MasterSaveJump ||
+                 D->K == DeduBBDirectives::MasterSaveJump2;
+    W.TwoExit = D->K == DeduBBDirectives::MasterSaveJump2 ||
+                D->K == DeduBBDirectives::FoldSaveJump2;
+    W.LinkRegs.push_back(Link);
+    if (W.TwoExit)
+      W.LinkRegs.push_back(Link2);
+    SaveJumpExits X;
+    if ((W.TwoExit && !Link2.isValid()) ||
+        !getSaveJumpExits(*MBB, TII, W.TwoExit, X) ||
+        !isSaveJumpBody(*MBB, TRI, W.LinkRegs)) {
+      ++NumSJIneligible;
+      continue;
+    }
+    W.Site = checkSite(*MBB, X.Exits, TRI, W.LinkRegs);
+    // A master whose own exits rule out the in-place rewrite is still emitted,
+    // as an out-of-line copy: folds in other functions depend on its label.
+    W.InPlace = W.IsMaster && W.Site == SiteProblem::None &&
+                canRewriteMasterInPlace(*MBB);
+    W.Cond = std::move(X.Cond);
+    W.Sym = ((W.TwoExit ? "DeduBB.master.sj2." : "DeduBB.master.sj.") +
+             Twine(D->MasterID))
+                .str();
+    Todo.push_back(std::move(W));
+  }
+  if (Todo.empty())
+    return false;
+
+  // Phase 1: route every edge into an in-place master through a new block that
+  // will load the master's return address. Doing this before any stub is
+  // emitted means every return address computed below already points at
+  // these blocks, never directly at a master.
+  DenseMap<MachineBasicBlock *, MachineBasicBlock *> SaveBlockOf;
+  for (Work &W : Todo) {
+    if (!W.InPlace)
+      continue;
+    MachineBasicBlock &MBB = *W.MBB;
+    MachineBasicBlock *SaveBlock = MF.CreateMachineBasicBlock();
+    MF.insert(MBB.getIterator(), SaveBlock);
+    SmallVector<MachineBasicBlock *, 4> Preds(MBB.predecessors());
+    for (MachineBasicBlock *Pred : Preds)
+      Pred->ReplaceUsesOfBlockWith(&MBB, SaveBlock);
+    if (MachineJumpTableInfo *JTI = MF.getJumpTableInfo())
+      JTI->ReplaceMBBInJumpTables(&MBB, SaveBlock);
+    for (const MachineBasicBlock::RegisterMaskPair &LI : MBB.liveins())
+      SaveBlock->addLiveIn(LI);
+    SaveBlock->addSuccessor(&MBB); // Falls through into the master.
+    SaveBlockOf[&MBB] = SaveBlock;
+  }
+
+  // Out-of-line copies go right after the last block that ends in a barrier
+  // (an unconditional jump or a return), so nothing falls into them. Blocks
+  // after it keep their place at the end of the function: an empty block left
+  // by `unreachable` must stay last, so a branch to it still runs off the end
+  // of the function (into padding) rather than into a copy. Found after phase 1
+  // so that a SaveBlock stays in front of its master.
+  MachineFunction::iterator CopyPt = MF.end();
+  for (MachineBasicBlock &MBB : reverse(MF)) {
+    MachineBasicBlock::iterator Last = MBB.getLastNonDebugInstr();
+    if (Last != MBB.end() && Last->isBarrier()) {
+      CopyPt = std::next(MBB.getIterator());
+      break;
+    }
+  }
+
+  // Phase 2: emit the masters and the folds.
+  for (Work &W : Todo) {
+    MachineBasicBlock &MBB = *W.MBB;
+    // Re-read the exits: phase 1 may have redirected them to SaveBlocks.
+    SaveJumpExits X;
+    const bool HaveExits = getSaveJumpExits(MBB, TII, W.TwoExit, X);
+
+    if (W.IsMaster) {
+      if (W.InPlace && HaveExits) {
+        // SaveBlock: load the master's own return addresses, then fall through
+        // into the master.
+        MachineBasicBlock &SaveBlock = *SaveBlockOf[&MBB];
+        for (auto [Exit, Reg] : zip_equal(X.Exits, W.LinkRegs)) {
+          TII.insertDeduBBLoadReturnAddress(SaveBlock, *Exit, Reg);
+          Exit->setLabelMustBeEmitted();
+        }
+        // Master: return through the link registers instead of branching.
+        MBB.erase(MBB.getFirstTerminator(), MBB.end());
+        SmallVector<MachineBasicBlock *, 2> Rets =
+            emitMasterReturn(MBB, W.LinkRegs, X.Cond, TII);
+        if (W.TwoExit) {
+          // The exits are now reached from the return blocks.
+          for (auto [Exit, Ret] : zip_equal(X.Exits, Rets)) {
+            MBB.replaceSuccessor(Exit, Ret);
+            Ret->addSuccessor(Exit);
+            for (const MachineBasicBlock::RegisterMaskPair &LI :
+                 Exit->liveins())
+              Ret->addLiveIn(LI);
+          }
+        }
+        for (MCRegister Reg : W.LinkRegs)
+          MBB.addLiveIn(Reg);
+        addMasterLabel(MBB, W.Sym, TII);
+        if (W.TwoExit)
+          ++NumSJ2MastersInPlace;
+        else
+          ++NumSJMastersInPlace;
+        continue;
+      }
+      // Out-of-line copy at CopyPt, reachable only from folded blocks.
+      // Instructions that emit no bytes (CFI, labels, debug info) are not
+      // copied.
+      MachineBasicBlock *Copy = MF.CreateMachineBasicBlock();
+      MF.insert(CopyPt, Copy);
+      for (MachineInstr &MI : MBB)
+        if (!MI.isTerminator() && !MI.isMetaInstruction())
+          Copy->push_back(MF.CloneMachineInstr(&MI));
+      for (const MachineBasicBlock::RegisterMaskPair &LI : MBB.liveins())
+        Copy->addLiveIn(LI);
+      for (MCRegister Reg : W.LinkRegs)
+        Copy->addLiveIn(Reg);
+      for (MachineBasicBlock *Ret :
+           emitMasterReturn(*Copy, W.LinkRegs, W.Cond, TII))
+        if (Ret != Copy)
+          Copy->addSuccessor(Ret);
+      addMasterLabel(*Copy, W.Sym, TII);
+      if (W.TwoExit)
+        ++NumSJ2MastersCopied;
+      else
+        ++NumSJMastersCopied;
+      // The master's own block can then become a fold of the copy.
+    }
+
+    if (!HaveExits) {
+      ++NumSJIneligible;
+      continue;
+    }
+    if (W.Site != SiteProblem::None) {
+      if (W.Site == SiteProblem::BadExit)
+        ++NumSJBadExit;
+      else if (W.Site == SiteProblem::LinkRegLive)
+        ++NumSJLinkRegLive;
+      else
+        ++NumSJ2SecondLinkRegLive;
+      continue;
+    }
+    if (!isReplaceable(MBB)) {
+      ++NumSJNotReplaceable;
+      continue;
+    }
+    emitSaveJumpFold(MBB, X.Exits, W.LinkRegs, W.Sym, TII);
+    if (W.TwoExit)
+      ++NumSJ2Folds;
+    else
+      ++NumSJFolds;
+  }
+  return true;
+}
+
+bool DeduBB::runOnMachineFunction(MachineFunction &MF) {
+  const DeduBBDirectives &Directives = DeduBBDirectives::get();
+  if (Directives.empty())
+    return false;
+
+  const TargetInstrInfo *TII = MF.getSubtarget().getInstrInfo();
+  if (!TII->supportsDeduBB())
+    return false;
+
+  // Collect the directives first: Save-and-Jump adds blocks to the function.
+  using Item = std::pair<MachineBasicBlock *, const DeduBBDirectives::Directive *>;
+  SmallVector<Item, 8> TailCallFolds, SaveJumps;
+  for (MachineBasicBlock &MBB : MF) {
+    std::optional<UniqueBBID> ID = MBB.getBBID();
+    // Only original (non-cloned) blocks carry directives.
+    if (!ID || ID->CloneID != 0)
+      continue;
+    const DeduBBDirectives::Directive *D =
+        Directives.lookup(MF.getFunction(), ID->BaseID);
+    if (!D || D->K == DeduBBDirectives::Master)
+      continue; // Tail-call masters are labelled by the AsmPrinter.
+    if (D->K == DeduBBDirectives::MasterCallReturn ||
+        D->K == DeduBBDirectives::FoldCallReturn)
+      continue; // Applied by the DeduBBCallReturn pass.
+    if (D->K == DeduBBDirectives::Fold)
+      TailCallFolds.push_back({&MBB, D});
+    else
+      SaveJumps.push_back({&MBB, D});
+  }
+
+  bool Changed = false;
+  for (auto [MBB, D] : TailCallFolds) {
+    // The fold's jump replaces every way out of the block, so it must have
+    // none but its return or tail call: no fall-through (a conditional tail
+    // call) and no landing pad.
+    if (!MBB->succ_empty()) {
+      ++NumTailCallSkipSuccessors;
+      continue;
+    }
+    // Step 1 groups blocks that run the same instructions to the same
+    // addresses, so the master, which runs its own calls and jumps, reaches
+    // what this block did. Only symbols that are the targets of direct calls
+    // and jumps, and that the directive names in order, can be checked
+    // against that; a block naming anything else (data, a constant pool, a
+    // jump table, a label) or anything unlisted is left as is.
+    SmallVector<std::string, 4> Callees;
+    bool Unlisted = false;
+    for (const MachineInstr &MI : *MBB) {
+      if (MI.isDebugInstr())
+        continue;
+      for (const MachineOperand &MO : MI.operands()) {
+        if (MO.isCPI() || MO.isJTI() || MO.isBlockAddress() ||
+            MO.isTargetIndex()) {
+          Unlisted = true;
+        } else if (MO.isGlobal() || MO.isSymbol() || MO.isMCSymbol()) {
+          if (!MI.isCall() || MO.getOffset() != 0)
+            Unlisted = true;
+          else
+            Callees.push_back(DeduBBDirectives::getCalleeName(MO));
+        }
+      }
+    }
+    if (Unlisted || !DeduBBDirectives::calleesMatch(D->Callees, Callees)) {
+      ++NumTailCallSkipSymbols;
+      continue;
+    }
+
+    // Replace the entire block with a single tail branch to the master copy.
+    std::string MasterSym = ("DeduBB.master." + Twine(D->MasterID)).str();
+    MBB->erase(MBB->begin(), MBB->end());
+    TII->insertDeduBBTailBranch(*MBB, MasterSym);
+    while (!MBB->succ_empty())
+      MBB->removeSuccessor(MBB->succ_begin());
+    ++NumTailCallFolds;
+    Changed = true;
+  }
+
+  Changed |= applySaveAndJump(MF, SaveJumps);
+  return Changed;
+}
+
+MachineFunctionPass *llvm::createDeduBBPass() { return new DeduBB(); }
