+  bool supportsDeduBB() const override { return true; }
+  void insertDeduBBTailBranch(MachineBasicBlock &MBB,
+                              StringRef MasterSym) const override;
+
   void buildClearRegister(Register Reg, MachineBasicBlock &MBB,
                           MachineBasicBlock::iterator Iter, DebugLoc &DL,
                           bool AllowSideEffects = true) const override;
diff --git a/llvm/lib/Target/X86/X86InstrInfo.cpp b/llvm/lib/Target/X86/X86InstrInfo.cpp
index 7ff2400d06d1..99974c843553 100644
--- a/llvm/lib/Target/X86/X86InstrInfo.cpp
+++ b/llvm/lib/Target/X86/X86InstrInfo.cpp
@@ -10660,6 +10660,40 @@ MachineBasicBlock::iterator X86InstrInfo::insertOutlinedCall(
   return It;
 }
 
+void X86InstrInfo::insertDeduBBTailBranch(MachineBasicBlock &MBB,
+                                          StringRef MasterSym) const {
+  // A tail jump to the master copy preserves the current frame, exactly like a
+  // tail-called outlined function (see insertOutlinedCall above).
+  const char *Sym = MBB.getParent()->createExternalSymbolName(MasterSym);
+  BuildMI(&MBB, DebugLoc(), get(X86::TAILJMPd64)).addExternalSymbol(Sym);
+}
+
+MCRegister X86InstrInfo::getDeduBBLinkRegister() const {
+  // R11 is caller-saved, is never an argument register, and is the
+  // conventional scratch register for PLT stubs and veneers.
+  return Subtarget.is64Bit() ? MCRegister(X86::R11) : MCRegister();
+}
+
+MCRegister X86InstrInfo::getDeduBBSecondLinkRegister() const {
+  // R10 is caller-saved and carries an argument only for the static chain
+  // (`nest`); the DeduBB pass checks that it is dead wherever it is written.
+  return Subtarget.is64Bit() ? MCRegister(X86::R10) : MCRegister();
+}
+
+void X86InstrInfo::insertDeduBBLoadReturnAddress(MachineBasicBlock &MBB,
+                                                 MachineBasicBlock &Target,
+                                                 MCRegister Reg) const {
+  // leaq Target(%rip), Reg
+  BuildMI(&MBB, DebugLoc(), get(X86::LEA64r), Reg)
+      .addReg(X86::RIP).addImm(1).addReg(0).addMBB(&Target).addReg(0);
+}
+
+void X86InstrInfo::insertDeduBBSaveAndJumpReturn(MachineBasicBlock &MBB,
+                                                 MCRegister Reg) const {
+  // jmpq *Reg
+  BuildMI(&MBB, DebugLoc(), get(X86::JMP64r)).addReg(Reg, RegState::Kill);
+}
+
 void X86InstrInfo::buildClearRegister(Register Reg, MachineBasicBlock &MBB,
                                       MachineBasicBlock::iterator Iter,
                                       DebugLoc &DL,
