@@ -2282,6 +2282,121 @@ public:
         "Target didn't implement TargetInstrInfo::insertOutlinedCall!");
   }
 
+  /// Returns true if this target implements \c insertDeduBBTailBranch, i.e. it
+  /// supports DeduBB tail-call basic block deduplication.
+  virtual bool supportsDeduBB() const { return false; }
+
+  /// Appends a tail branch to the external symbol \p MasterSym at the end of
+  /// \p MBB. Used by the DeduBB pass to fold a duplicate tail-call/return block
+  /// into its master copy. Modeled on \c insertOutlinedCall's tail-call path so
+  /// that the current stack frame is preserved.
+  virtual void insertDeduBBTailBranch(MachineBasicBlock &MBB,
+                                      StringRef MasterSym) const {
+    llvm_unreachable(
+        "Target didn't implement TargetInstrInfo::insertDeduBBTailBranch!");
+  }
+
+  /// Returns the register that carries a folded block's return address into
+  /// its Save-and-Jump master (R11 on x86-64), or an invalid register if the
+  /// target does not support Save-and-Jump. The DeduBB pass only folds blocks
+  /// that never touch this register and where it is dead on exit.
+  virtual MCRegister getDeduBBLinkRegister() const { return MCRegister(); }
+
+  /// Returns the register that carries the not-taken return address of a
+  /// two-exit Save-and-Jump fold (R10 on x86-64), or an invalid register if the
+  /// target has no two-exit Save-and-Jump. The taken return address travels in
+  /// \c getDeduBBLinkRegister.
+  virtual MCRegister getDeduBBSecondLinkRegister() const {
+    return MCRegister();
+  }
+
+  /// Appends a load of \p Target's address into \p Reg to \p MBB.
+  virtual void insertDeduBBLoadReturnAddress(MachineBasicBlock &MBB,
+                                             MachineBasicBlock &Target,
+                                             MCRegister Reg) const {
+    llvm_unreachable(
+        "Target didn't implement TargetInstrInfo::insertDeduBBLoadReturnAddress!");
+  }
+
+  /// Appends a Save-and-Jump master's return, an indirect jump through \p Reg,
+  /// to \p MBB.
+  virtual void insertDeduBBSaveAndJumpReturn(MachineBasicBlock &MBB,
+                                             MCRegister Reg) const {
+    llvm_unreachable(
+        "Target didn't implement TargetInstrInfo::insertDeduBBSaveAndJumpReturn!");
+  }
+
+  /// DeduBB Call-Return: returns the registers that the body of a folded block
+  /// must not reference, other than through the stack effects of its calls:
+  /// the stack pointer, the program counter and any shadow-stack pointer. The
+  /// body runs inside a master with the stack pointer moved. Empty if the
+  /// target does not support Call-Return.
+  virtual ArrayRef<MCPhysReg> getDeduBBCallReturnForbiddenRegs() const {
+    return {};
+  }
+
+  /// DeduBB Call-Return: returns false if a block holding \p MI must keep its
+  /// body because of what \p MI is, rather than its operands: a call other
+  /// than a plain direct or indirect one, or a pseudo lowered into more than
+  /// one instruction, or into code that belongs to its function or place or
+  /// that the linker rewrites. For a call, sets \p Callee to the callee
+  /// operand of a direct call, or to nullptr for a call through a register or
+  /// memory.
+  virtual bool isDeduBBCallReturnMovable(const MachineInstr &MI,
+                                         const MachineOperand *&Callee) const {
+    return false;
+  }
+
+  /// DeduBB Call-Return: returns true if the blocks of \p MF may call a
+  /// master: the calling convention, code model and hardening options allow
+  /// an extra call anywhere in the function.
+  virtual bool supportsDeduBBCallReturn(const MachineFunction &MF) const {
+    return false;
+  }
+
+  /// DeduBB Call-Return: returns true if \p MF may keep data below the stack
+  /// pointer, where a call's return address would overwrite it.
+  virtual bool hasDeduBBRedZone(const MachineFunction &MF) const {
+    return true;
+  }
+
+  /// DeduBB Call-Return: inserts a call to the master \p MasterSym before
+  /// \p InsertPt and returns the call instruction. If \p WithCalls, the master
+  /// makes calls itself, and the stack must stay aligned for them; \p EmitCFI
+  /// then asks for CFI describing the stack adjustment.
+  virtual MachineInstr *
+  insertDeduBBCallReturnStub(MachineBasicBlock &MBB,
+                             MachineBasicBlock::iterator InsertPt,
+                             StringRef MasterSym, bool WithCalls,
+                             bool EmitCFI) const {
+    llvm_unreachable(
+        "Target didn't implement TargetInstrInfo::insertDeduBBCallReturnStub!");
+  }
+
+  /// DeduBB Call-Return: appends a master's return to \p MBB.
+  virtual void insertDeduBBCallReturnRet(MachineBasicBlock &MBB) const {
+    llvm_unreachable(
+        "Target didn't implement TargetInstrInfo::insertDeduBBCallReturnRet!");
+  }
+
+  /// DeduBB Call-Return: appends to a master, \p MBB, a direct call to \p GV,
+  /// or to the function named \p Name if \p GV is null, made the way a call
+  /// of this module reaches it.
+  virtual void insertDeduBBCallReturnMasterCall(MachineBasicBlock &MBB,
+                                                const GlobalValue *GV,
+                                                StringRef Name) const {
+    llvm_unreachable("Target didn't implement "
+                     "TargetInstrInfo::insertDeduBBCallReturnMasterCall!");
+  }
+
+  /// DeduBB Call-Return: returns the "target-features" of the function that
+  /// holds the masters taken from a function with \p Features, without any
+  /// feature that would change how the masters return.
+  virtual std::string
+  getDeduBBCallReturnMasterFeatures(StringRef Features) const {
+    return Features.str();
+  }
+
