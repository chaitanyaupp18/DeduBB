+; CHECK-NEXT:  .hidden DeduBB.master.cr.8
+; CHECK-NEXT:  DeduBB.master.cr.8:
+; CHECK-NEXT:  #APP
+; CHECK-COUNT-6: .byte
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  callq g@PLT
+; CHECK-NEXT:  {{^\.LBB[0-9]+_1_CS0}}:
+; CHECK-NEXT:  #APP
+; CHECK-NEXT:  .byte 255
+; CHECK-NEXT:  .byte 3
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  retq
+; CHECK:       DeduBB.master.cr.10:
+; CHECK-NEXT:  #APP
+; CHECK-COUNT-8: .byte
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  retq
+; CHECK:       DeduBB.master.cr.11:
+; CHECK-NEXT:  #APP
+; CHECK-COUNT-6: .byte
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  callq g@PLT
+; CHECK-NEXT:  {{^\.LBB[0-9]+_3_CS0}}:
+; CHECK-NEXT:  retq
+; CHECK:       .cfi_endproc
+
+; SW-LABEL: sw_fp:
+; SW:       {{^\.LBB0_1}}: # %work
+; SW-NEXT:  pushq %rbp
+; SW:       .cfi_def_cfa_register %rbp
