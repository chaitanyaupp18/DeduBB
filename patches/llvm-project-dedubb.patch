diff --git a/llvm/include/llvm/CodeGen/DeduBBDirectives.h b/llvm/include/llvm/CodeGen/DeduBBDirectives.h
new file mode 100644
index 000000000000..abc008a98da4
--- /dev/null
+++ b/llvm/include/llvm/CodeGen/DeduBBDirectives.h
@@ -0,0 +1,143 @@
+//===- llvm/CodeGen/DeduBBDirectives.h - DeduBB directive reader -*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Reads the DeduBB tail-call deduplication directive file produced by Propeller
+// (the `--tail_call_profile=dedubb.txt` output) and answers per-block queries
+// used by the DeduBB CodeGen pass and the AsmPrinter.
+//
+// The directive file groups directives by module and function:
+//
+//     m <module>
+//     f <function>
+//     bbm <bb_id> (DeduBB.master.<K>) [callees=<c>] ; master copy K
+//     bbf <bb_id> (DeduBB.master.<K>) [callees=<c>] ; fold into master K
+//     bbmsj <bb_id> (DeduBB.master.sj.<K>)  ; Save-and-Jump master copy K
+//     bbfsj <bb_id> (DeduBB.master.sj.<K>)  ; Save-and-Jump fold into K
+//     bbmsj2 <bb_id> (DeduBB.master.sj2.<K>) ; two-exit Save-and-Jump master
+//     bbfsj2 <bb_id> (DeduBB.master.sj2.<K>) ; two-exit Save-and-Jump fold
+//     bbmcr <bb_id> (DeduBB.master.cr.<K>) callees=<c> insts=<n> body=<b>
+//     bbfcr <bb_id> (DeduBB.master.cr.<K>) callees=<c> insts=<n>
+//
+// `bbm` marks a basic block as the master copy: the compiler emits a global
+// symbol `DeduBB.master.<K>` at the start of the block so that duplicates in
+// this and other modules can branch to it. `bbf` marks a duplicate that ends
+// in a tail call or return: the compiler replaces the whole block with a single
+// jump to `DeduBB.master.<K>`. The copies are byte-identical, except that a
+// direct call or jump reaches the same target from each: <c> names those
+// targets like a Call-Return `callees=` below, and a block whose calls and
+// jumps do not match it (or that has any without it) is not folded.
+//
+// `bbmsj`/`bbfsj` do the same for single-successor blocks that fall through.
+// The fold passes its successor's address to the master in the target's link
+// register (R11 on x86-64), and the master returns with an indirect jump
+// through it. `bbmsj2`/`bbfsj2` do the same for blocks that end in a
+// conditional branch: the fold passes both successors (R11 and R10 on x86-64)
+// and the master's conditional branch picks the one to return through. See
+// DeduBB.cpp for the eligibility rules.
+//
+// `bbmcr`/`bbfcr` are Call-Return directives. Every block of the group, the
+// master's included, keeps its branches but its body, everything before them,
+// becomes a call to one shared copy of the body that ends in a return. The
+// DeduBBCallReturn pass emits that copy, labelled `DeduBB.master.cr.<K>`, in a
+// function of its own. <c> lists the calls the body makes, in order and
+// separated by ',': the names of a direct call's target separated by '|', or
+// '*' for a call through a register or memory. It is empty if the body makes
+// no call. <n> is the number of instructions in the body. <b> is the body
+// itself in hex, split by '.' where each direct call goes. See
+// DeduBBCallReturn.cpp for the eligibility rules.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CODEGEN_DEDUBBDIRECTIVES_H
+#define LLVM_CODEGEN_DEDUBBDIRECTIVES_H
+
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/StringMap.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/Compiler.h"
+#include <cstdint>
+#include <string>
+
+namespace llvm {
+
+class Function;
+class MachineOperand;
+
+class DeduBBDirectives {
+public:
+  enum Kind {
+    Master,
+    Fold,
+    MasterSaveJump,
+    FoldSaveJump,
+    MasterSaveJump2,
+    FoldSaveJump2,
+    MasterCallReturn,
+    FoldCallReturn
+  };
+
+  struct Directive {
+    Kind K;
+    uint64_t MasterID; // K in `DeduBB.master.K`.
+    // The `callees=` list (tail-call and Call-Return directives), and, for
+    // Call-Return only, the `insts=` count and, for a master, the `body=` hex.
+    std::string Callees;
+    unsigned NumInsts = 0;
+    std::string Body;
+  };
+
+  // Parses directive text (the contents of a dedubb.txt file). Lines starting
+  // with '#' are comments. Returns false and reports to errs() on a malformed
+  // line, leaving already-parsed directives in place.
+  LLVM_ABI bool parse(StringRef Text);
+
+  // Returns the directive for basic block `BBID` of function `FuncName`, or
+  // nullptr if the block has no directive.
+  LLVM_ABI const Directive *lookup(StringRef FuncName, unsigned BBID) const;
+
+  // Returns the directive for basic block `BBID` of `F`, looked up by the
+  // function's name and then by the names of its aliases.
+  LLVM_ABI const Directive *lookup(const Function &F, unsigned BBID) const;
+
+  // Returns the directives of `F` by basic block id, looked up like the
+  // above, or nullptr if it has none.
+  LLVM_ABI const DenseMap<unsigned, Directive> *
+  getFunction(const Function &F) const;
+
+  // Returns true if the function has any Save-and-Jump directives.
+  LLVM_ABI bool hasSaveJump(StringRef FuncName) const;
+
+  // Returns true if \p Listed, a directive's `callees=`, names the calls
+  // \p Actual in order. Each call may match any of its '|'-separated names.
+  LLVM_ABI static bool calleesMatch(StringRef Listed,
+                                    ArrayRef<std::string> Actual);
+
+  // Returns the name the target of a direct call, \p MO, has in the object
+  // file.
+  LLVM_ABI static std::string getCalleeName(const MachineOperand &MO);
+
+  // Returns true if there are any Call-Return directives.
+  bool hasCallReturn() const { return HasCallReturn; }
+
+  bool empty() const { return Map.empty(); }
+
+  // Returns the process-wide directives, lazily parsed from the file named by
+  // the `-dedubb-directives` command-line option (empty if the option is
+  // unset). Shared by the DeduBB pass and the AsmPrinter.
+  LLVM_ABI static const DeduBBDirectives &get();
+
+private:
+  // Function name -> (basic block id -> directive).
+  StringMap<DenseMap<unsigned, Directive>> Map;
+  bool HasCallReturn = false;
+};
+
+} // namespace llvm
+
+#endif // LLVM_CODEGEN_DEDUBBDIRECTIVES_H
