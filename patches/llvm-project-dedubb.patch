diff --git a/llvm/test/CodeGen/X86/dedubb-tail-call-callees.ll b/llvm/test/CodeGen/X86/dedubb-tail-call-callees.ll
new file mode 100644
index 000000000000..9fc7d9c17295
--- /dev/null
+++ b/llvm/test/CodeGen/X86/dedubb-tail-call-callees.ll
@@ -0,0 +1,84 @@
+; Tests `callees=` on tail-call directives: a bbf block that calls or jumps to
+; a function is folded only if the directive names exactly its targets, and a
+; block with a successor or another symbol is never folded.
+
+; RUN: printf 'm test.c\nf m_call\nbbm 0 (DeduBB.master.1) callees=callee\nf f_call\nbbf 0 (DeduBB.master.1) callees=other|callee\nf f_wrong\nbbf 0 (DeduBB.master.1) callees=other\nf f_nolist\nbbf 0 (DeduBB.master.1)\nf m_data\nbbm 0 (DeduBB.master.2)\nf f_data\nbbf 0 (DeduBB.master.2) callees=\nf f_succ\nbbf 0 (DeduBB.master.2)\n' > %t.dir
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -basic-block-address-map \
+; RUN:     -dedubb-directives=%t.dir < %s | FileCheck %s
+
+declare i32 @callee(i32)
+
+@g = global i32 0
+
+; CHECK-LABEL: m_call:
+; CHECK:       DeduBB.master.1:
+; CHECK:       jmp callee
+define i32 @m_call(i32 %x) {
+  %a = add i32 %x, 7
+  %r = tail call i32 @callee(i32 %a)
+  ret i32 %r
+}
+
+; The directive names the tail call's target (as one of its names): folded.
+; CHECK-LABEL: f_call:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  jmp DeduBB.master.1
+; CHECK-NOT:   callee
+; CHECK:       .Lfunc_end
+define i32 @f_call(i32 %x) {
+  %a = add i32 %x, 7
+  %r = tail call i32 @callee(i32 %a)
+  ret i32 %r
+}
+
+; The directive names another function: left as is.
+; CHECK-LABEL: f_wrong:
+; CHECK-NOT:   DeduBB.master
+; CHECK:       jmp callee
+define i32 @f_wrong(i32 %x) {
+  %a = add i32 %x, 7
+  %r = tail call i32 @callee(i32 %a)
+  ret i32 %r
+}
+
+; No `callees=` (a directive from an older Step 1): left as is.
+; CHECK-LABEL: f_nolist:
+; CHECK-NOT:   DeduBB.master
+; CHECK:       jmp callee
+define i32 @f_nolist(i32 %x) {
+  %a = add i32 %x, 7
+  %r = tail call i32 @callee(i32 %a)
+  ret i32 %r
+}
+
+; CHECK-LABEL: m_data:
+; CHECK:       DeduBB.master.2:
+define i32 @m_data(i32 %x) {
+  %v = load i32, ptr @g
+  %s = add i32 %v, %x
+  ret i32 %s
+}
+
+; A symbol that is not a call target cannot be checked: left as is.
+; CHECK-LABEL: f_data:
+; CHECK-NOT:   DeduBB.master
+; CHECK:       {{g(@GOTPCREL)?}}(%rip)
+define i32 @f_data(i32 %x) {
+  %v = load i32, ptr @g
+  %s = add i32 %v, %x
+  ret i32 %s
+}
+
+; A block with successors: its fold would lose them, so it is left as is.
+; CHECK-LABEL: f_succ:
+; CHECK-NOT:   DeduBB.master
+; CHECK:       .Lfunc_end
+define i32 @f_succ(i32 %x) {
+entry:
+  %c = icmp eq i32 %x, 0
+  br i1 %c, label %a, label %b
+a:
+  ret i32 1
+b:
+  ret i32 2
+}
