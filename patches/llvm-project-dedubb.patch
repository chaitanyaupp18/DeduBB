+declare void @g(i32)
+
+define void @sw_fp(i32 %a, ptr %p) "frame-pointer"="all" {
+entry:
+  %c = icmp sgt i32 %a, 0
+  br i1 %c, label %work, label %exit
+work:
+  call void @g(i32 %a)
+  %c2 = icmp sgt i32 %a, 5
+  br i1 %c2, label %body, label %exit
+body:
