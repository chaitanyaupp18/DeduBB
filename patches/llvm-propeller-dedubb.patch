@@ -0,0 +1,241 @@
+// Copyright 2026 The Propeller Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "propeller/call_return_dedupper.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <set>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace propeller {
+namespace {
+
+// Orders blocks deterministically; the hottest is promoted to the master. A
+// function without a ThinLTO ".llvm." suffix is preferred, then the lowest
+// address, as for the other kinds.
+bool BlockOrderLess(const CallReturnBlock& a, const CallReturnBlock& b) {
+  if (a.frequency != b.frequency) return a.frequency > b.frequency;
+  const bool a_has_llvm = a.function_name.find(".llvm.") != std::string::npos;
+  const bool b_has_llvm = b.function_name.find(".llvm.") != std::string::npos;
+  if (a_has_llvm != b_has_llvm) return !a_has_llvm;
+  return std::tie(a.address, a.module_name, a.function_name, a.bb_id) <
+         std::tie(b.address, b.module_name, b.function_name, b.bb_id);
+}
+
+bool DirectiveOrderLess(const Directive& a, const Directive& b) {
+  return std::tie(a.module_name, a.function_name, a.bb_id) <
+         std::tie(b.module_name, b.function_name, b.bb_id);
+}
+
+std::string JoinCallees(const std::vector<std::string>& callees) {
+  std::string out;
+  for (const std::string& callee : callees) {
+    if (!out.empty()) out += ',';
+    out += callee;
+  }
+  return out;
+}
+
+}  // namespace
+
+void AppendDirectCallToKey(std::vector<uint8_t>& key, const uint8_t* call,
+                           size_t size, uint64_t target) {
+  key.insert(key.end(), call, call + size - 4);
+  for (int i = 0; i < 8; ++i)
+    key.push_back(static_cast<uint8_t>(target >> (8 * i)));
+}
+
+CallReturnDedupResult DeduplicateCallReturnBlocks(
+    const std::vector<CallReturnBlock>& blocks,
+    const CallReturnDedupOptions& options) {
+  CallReturnDedupResult result;
+
+  std::vector<int> order(blocks.size());
+  for (int i = 0; i < static_cast<int>(blocks.size()); ++i) order[i] = i;
+  std::sort(order.begin(), order.end(), [&](int x, int y) {
+    return BlockOrderLess(blocks[x], blocks[y]);
+  });
+
+  // Bucket by FNV-1a hash of the key, then split each bucket into groups with
+  // identical keys. The hash is only a fast filter; membership is decided by an
+  // exact comparison, which rules out collisions.
+  std::unordered_map<uint64_t, std::vector<std::vector<int>>> buckets;
+  for (int idx : order) {
+    const CallReturnBlock& block = blocks[idx];
+    if (block.key.empty() || block.body_size == 0) continue;
+    std::vector<std::vector<int>>& bucket = buckets[Fnv1aHash(block.key)];
+    std::vector<int>* match = nullptr;
+    for (std::vector<int>& group : bucket) {
+      const CallReturnBlock& rep = blocks[group.front()];
+      if (rep.key == block.key && rep.body_size == block.body_size &&
+          rep.callees == block.callees &&
+          (!options.intra_module_only ||
+           rep.module_name == block.module_name)) {
+        match = &group;
+        break;
+      }
+    }
+    if (match == nullptr) {
+      bucket.push_back({idx});
+    } else {
+      match->push_back(idx);
+    }
+  }
+
+  // Cost each group. Every member, the master's own block included, shrinks
+  // from its body to a stub; the master routine holds the body once more,
+  // plus its `ret`. All members of a group have the same body, so either all
+  // of them fold or none does.
+  struct Plan {
+    const std::vector<int>* members;
+    int64_t benefit;
+  };
+  std::vector<Plan> plans;
+  for (auto& [hash, bucket] : buckets) {
+    for (const std::vector<int>& group : bucket) {
+      const int members = static_cast<int>(group.size());
+      if (members < options.min_occurrences) continue;
+      const CallReturnBlock& master = blocks[group.front()];
+      const int64_t body = master.body_size;
+      const int64_t stub = master.callees.empty()
+                               ? options.stub_size
+                               : options.stub_size_with_calls;
+      const int64_t benefit =
+          members * (body - stub) - (body + options.master_overhead);
+      if (benefit <= 0) continue;
+      plans.push_back({&group, benefit});
+    }
+  }
+  // Sort by the master block so master ids are stable.
+  std::sort(plans.begin(), plans.end(), [&](const Plan& x, const Plan& y) {
+    return BlockOrderLess(blocks[x.members->front()],
+                          blocks[y.members->front()]);
+  });
+
+  std::set<std::string> master_modules;
+  uint64_t master_id = options.first_master_id;
+  for (const Plan& plan : plans) {
+    const std::vector<int>& members = *plan.members;
+    const CallReturnBlock& master = blocks[members.front()];
+    const std::string callees = JoinCallees(master.callees);
+    const bool with_calls = !master.callees.empty();
+    for (size_t i = 0; i < members.size(); ++i) {
+      const CallReturnBlock& block = blocks[members[i]];
+      Directive directive{i == 0 ? DirectiveKind::kMasterCallReturn
+                                 : DirectiveKind::kFoldCallReturn,
+                          block.module_name, block.function_name, block.bb_id,
+                          master_id};
+      directive.callees = callees;
+      directive.inst_count = block.inst_count;
+      if (i == 0) directive.body = FormatCallReturnBody(block);
+      result.directives.push_back(std::move(directive));
+      result.stub_addresses.push_back(block.address);
+    }
+    master_modules.insert(master.module_name);
+    ++result.num_groups;
+    result.num_stubs += static_cast<int>(members.size());
+    if (with_calls) {
+      ++result.num_groups_with_calls;
+      result.num_stubs_with_calls += static_cast<int>(members.size());
+    }
+    result.bytes_saved += plan.benefit;
+    ++master_id;
+  }
+  result.num_master_modules = static_cast<int>(master_modules.size());
+
+  std::sort(result.directives.begin(), result.directives.end(),
+            DirectiveOrderLess);
+  std::sort(result.stub_addresses.begin(), result.stub_addresses.end());
+  return result;
+}
+
+std::string FormatCallReturnBody(const CallReturnBlock& block) {
+  static constexpr char kHex[] = "0123456789abcdef";
+  std::string out;
+  size_t pos = 0;
+  const auto append = [&](size_t end) {
+    for (; pos < end; ++pos) {
+      out += kHex[block.key[pos] >> 4];
+      out += kHex[block.key[pos] & 15];
+    }
+  };
+  for (uint32_t call : block.call_key_offsets) {
+    append(call);
+    out += '.';
+    pos = call + 1 + 8;  // The call's opcode byte and its target.
+  }
+  append(block.key.size());
+  return out;
+}
+
+void OffsetCallReturnMasterIds(CallReturnDedupResult& result,
+                               uint64_t offset) {
+  for (Directive& directive : result.directives) directive.master_id += offset;
+}
+
+std::vector<SaveAndJumpBlock> RemoveBlocksAt(
+    const std::vector<SaveAndJumpBlock>& blocks,
+    const std::vector<uint64_t>& sorted_addresses) {
+  std::vector<SaveAndJumpBlock> kept;
+  kept.reserve(blocks.size());
+  for (const SaveAndJumpBlock& block : blocks) {
+    if (!std::binary_search(sorted_addresses.begin(), sorted_addresses.end(),
+                            block.address))
+      kept.push_back(block);
+  }
+  return kept;
+}
+
+std::string FormatCallReturnDirectives(const CallReturnDedupResult& result) {
+  std::string out;
+  const std::string* cur_module = nullptr;
+  const std::string* cur_function = nullptr;
+  for (const Directive& d : result.directives) {
+    if (cur_module == nullptr || *cur_module != d.module_name) {
+      out += "m ";
+      out += d.module_name;
+      out += "\n";
+      cur_module = &d.module_name;
+      cur_function = nullptr;  // force re-emitting the function header
+    }
+    if (cur_function == nullptr || *cur_function != d.function_name) {
+      out += "f ";
+      out += d.function_name;
+      out += "\n";
+      cur_function = &d.function_name;
+    }
+    out += d.kind == DirectiveKind::kMasterCallReturn ? "bbmcr " : "bbfcr ";
+    out += std::to_string(d.bb_id);
+    out += " (DeduBB.master.cr.";
+    out += std::to_string(d.master_id);
+    out += ") callees=";
+    out += d.callees;
+    out += " insts=";
+    out += std::to_string(d.inst_count);
+    if (d.kind == DirectiveKind::kMasterCallReturn) {
+      out += " body=";
+      out += d.body;
+    }
+    out += "\n";
+  }
+  return out;
+}
+
+}  // namespace propeller
