diff --git a/propeller/tail_call_dedupper.cc b/propeller/tail_call_dedupper.cc
new file mode 100644
index 0000000..69abcb7
--- /dev/null
+++ b/propeller/tail_call_dedupper.cc
@@ -0,0 +1,200 @@
+// Copyright 2026 The Propeller Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
