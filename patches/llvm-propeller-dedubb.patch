+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "propeller/tail_call_profile_writer.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <fstream>
+#include <initializer_list>
+#include <memory>
+#include <optional>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include "absl/container/flat_hash_map.h"
+#include "absl/log/log.h"
+#include "absl/status/status.h"
+#include "absl/status/statusor.h"
+#include "absl/strings/str_format.h"
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCInstrAnalysis.h"
+#include "llvm/MC/MCInstrDesc.h"
+#include "llvm/MC/MCInstrInfo.h"
+#include "llvm/MC/MCRegister.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/Object/ELFObjectFile.h"
+#include "llvm/Object/ObjectFile.h"
+#include "llvm/Object/SymbolicFile.h"
+#include "llvm/Support/Casting.h"
+#include "llvm/Support/Error.h"
+#include "llvm/TargetParser/Triple.h"
+#include "propeller/bb_addr_map.h"
+#include "propeller/bb_addr_map.pb.h"
+#include "propeller/binary_content.h"
+#include "propeller/call_return_dedupper.h"
+#include "propeller/mini_disassembler.h"
+#include "propeller/propeller_options.pb.h"
+#include "propeller/status_macros.h"  // Included for macros.
+#include "propeller/save_and_jump_dedupper.h"
+#include "propeller/tail_call_dedupper.h"
+
+namespace propeller {
+namespace {
+
+// Slices `size` raw bytes at binary address `addr` out of the text section that
+// contains it. Mirrors the section lookup used by `MiniDisassembler`.
+absl::StatusOr<std::vector<uint8_t>> GetBlockBytes(
+    const llvm::object::ObjectFile& object_file, uint64_t addr, uint64_t size) {
+  for (const llvm::object::SectionRef& section : object_file.sections()) {
+    if (!section.isText() || section.isVirtual()) continue;
+    const uint64_t section_addr = section.getAddress();
+    const uint64_t section_size = section.getSize();
+    if (addr < section_addr || addr + size > section_addr + section_size)
+      continue;
+    llvm::Expected<llvm::StringRef> content = section.getContents();
+    if (!content) {
+      return absl::FailedPreconditionError("section has no content");
+    }
+    const uint64_t offset = addr - section_addr;
+    const uint8_t* data =
+        reinterpret_cast<const uint8_t*>(content->data()) + offset;
+    return std::vector<uint8_t>(data, data + size);
+  }
+  return absl::NotFoundError(
+      absl::StrFormat("no text section contains address 0x%lx", addr));
+}
+
+}  // namespace
+
+bool IsAliased(const FunctionBbAddrMapPb& function) {
+  return function.function_names_size() > 1;
+}
+
+int TailCallPatchSize(const BinaryContent& binary_content) {
+  switch (llvm::Triple::ArchType(binary_content.object_file->getArch())) {
+    case llvm::Triple::x86:
+    case llvm::Triple::x86_64:
+      return 5;  // `jmp rel32`
+    case llvm::Triple::aarch64:
+    case llvm::Triple::aarch64_be:
+    case llvm::Triple::arm:
+    case llvm::Triple::armeb:
+    case llvm::Triple::thumb:
+    case llvm::Triple::thumbeb:
+      return 4;  // `b`
+    default:
+      return 5;
+  }
+}
+
+std::vector<TailCallBlock> BuildTailCallBlocks(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    bool cold_only, bool skip_aliased_functions) {
+  std::vector<TailCallBlock> blocks;
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps()) {
+    for (const FunctionBbAddrMapPb& function :
+         module.function_bb_addr_maps()) {
+      if (skip_aliased_functions && IsAliased(function)) continue;
+      const std::string function_name =
+          function.function_names().empty()
+              ? std::string(absl::StrFormat("0x%lx", function.function_address()))
+              : std::string(function.function_names(0));
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          // Only blocks that end in a tail call or a return are foldable with a
+          // single jump (DeduBB Case I).
+          if (!bb_entry.has_tail_call() && !bb_entry.has_return()) continue;
+          if (bb_entry.size() == 0) continue;
+          // Exception-handling pads have special unwinder requirements; leave
+          // them alone.
+          if (bb_entry.is_eh_pad()) continue;
+          // Optionally restrict to cold blocks to preserve hot-path
+          // performance (DeduBB profile-guided mode).
+          if (cold_only && (bb_entry.post_link_frequency() > 0 || bb_entry.frequency() > 0)) continue;
+
+          const uint64_t address = bb_range.base_address() + bb_entry.offset();
+          absl::StatusOr<std::vector<uint8_t>> bytes = GetBlockBytes(
+              *binary_content.object_file, address, bb_entry.size());
+          if (!bytes.ok()) {
+            LOG(WARNING) << "Skipping block " << function_name << "#"
+                         << bb_entry.id() << ": " << bytes.status().message();
+            continue;
+          }
+          std::string mod_name = std::string(module.module_name());
+          if (mod_name.empty()) {
+            size_t uniq_pos = function_name.find(".__uniq.");
+            if (uniq_pos != std::string::npos) {
+              mod_name = function_name.substr(uniq_pos + 8);
+            }
+          }
+          blocks.push_back(TailCallBlock{mod_name, function_name,
+                                         bb_entry.id(), address,
+                                         std::max(static_cast<uint64_t>(bb_entry.post_link_frequency()), static_cast<uint64_t>(bb_entry.frequency())),
+                                         *std::move(bytes)});
+        }
+      }
+    }
+  }
+  return blocks;
+}
+
+namespace {
+
+// Why a block is not a Save-and-Jump (DeduBB Case III) candidate. These mirror
+// the checks in llvm/lib/CodeGen/DeduBB.cpp that can be decided from machine
+// bytes, so the groups written here are groups the backend actually applies.
+// (The BbAddrMap `edges` come from the PGO analysis map and are empty without
+// one, so they cannot tell a `jcc` block from a single-successor block.)
+enum class SaveAndJumpReject {
+  kNone,
+  kBranch,        // Indirect branch, a second conditional branch, or a branch
+                  // before the end of the block.
+  kCall,          // The callee may clobber %r11 and %r10.
+  kR11,           // Reads or writes %r11, which carries the return address.
+  kR10,           // A two-exit block that reads or writes %r10, which carries
+                  // its second return address.
+  kRipRelative,   // Equal PC-relative bytes at different addresses name
+                  // different targets.
+  kStackPointer,  // Changes %rsp; the master's CFI describes another frame.
+  kSystem,        // syscall, int, ud, hlt.
+  kNoSuccessor,   // An exit is not another block of the same function.
+  kJumpOnly,      // Nothing but branches: no body to share.
+  kDecodeError,
+  kNumReasons,
+};
+
+constexpr std::array<const char*,
+                     static_cast<int>(SaveAndJumpReject::kNumReasons)>
+    kSaveAndJumpRejectNames = {"eligible",     "branch",       "call",
+                               "r11",          "r10",          "rip-relative",
+                               "rsp",          "system",       "no-successor",
+                               "jump-only",    "decode-error"};
+
+struct SaveAndJumpScanStats {
+  int64_t scanned = 0;
+  std::array<int64_t, static_cast<int>(SaveAndJumpReject::kNumReasons)>
+      by_reason{};
+};
+
+struct SaveAndJumpShape {
+  SaveAndJumpReject reject = SaveAndJumpReject::kNone;
+  bool two_exit = false;   // Ends in a conditional branch.
+  int condition = -1;      // That branch's condition code.
+  uint32_t jump_size = 0;  // Bytes of the branches at the end of the block.
+};
+
+// Decodes a block and decides whether it can be folded with Save-and-Jump:
+// straight-line code followed by one of
+//   (no branch)       one exit: the fall-through
+//   jmp T             one exit: T
+//   j<cc> T           two exits: T, or the fall-through
+//   j<cc> T ; jmp F   two exits: T or F
+// where every exit is another block of the same function.
+class SaveAndJumpAnalyzer {
+ public:
+  explicit SaveAndJumpAnalyzer(MiniDisassembler& disassembler)
+      : disassembler_(disassembler),
+        mii_(disassembler.instr_info()),
+        mri_(disassembler.register_info()),
+        r10_(FindRegister("R10")),
+        r11_(FindRegister("R11")),
+        rip_(FindRegister("RIP")),
+        rsp_(FindRegister("RSP")) {}
+
+  bool IsValid() const {
+    return r10_.isValid() && r11_.isValid() && rip_.isValid() &&
+           rsp_.isValid();
+  }
+
+  // Classifies the block `bytes` at `address`. `block_at` maps the start
+  // address of every block of the function to its entry.
+  SaveAndJumpShape Analyze(
+      llvm::ArrayRef<uint8_t> bytes, uint64_t address, bool can_fall_through,
+      const std::unordered_map<uint64_t, const BbEntryPb*>& block_at) const {
+    SaveAndJumpShape shape;
+    std::optional<uint64_t> taken;   // Target of the conditional branch.
+    std::optional<uint64_t> jumped;  // Target of the final `jmp`.
+    bool touches_r10 = false;
+    for (uint64_t offset = 0; offset < bytes.size();) {
+      uint64_t size = 0;
+      absl::StatusOr<llvm::MCInst> inst = disassembler_.DisassembleOne(
+          bytes.drop_front(offset), address + offset, size);
+      if (!inst.ok() || size == 0 || offset + size > bytes.size())
+        return {SaveAndJumpReject::kDecodeError};
+      const llvm::MCInstrDesc& desc = mii_.get(inst->getOpcode());
+      const llvm::StringRef name = mii_.getName(inst->getOpcode());
+      if (desc.isCall()) return {SaveAndJumpReject::kCall};
+      if (desc.mayAffectControlFlow(*inst, mri_)) {
+        // The master replaces the branches with its returns, and every copy
+        // returns to its own targets.
+        uint64_t target = 0;
+        if (!disassembler_.instr_analysis().evaluateBranch(
+                *inst, address + offset, size, target))
+          return {SaveAndJumpReject::kBranch};
+        if (name.starts_with("JCC_") && !shape.two_exit && !jumped &&
+            inst->getNumOperands() == 2 && inst->getOperand(1).isImm()) {
+          shape.two_exit = true;
+          shape.condition = static_cast<int>(inst->getOperand(1).getImm());
+          taken = target;
+        } else if (desc.isUnconditionalBranch() &&
+                   offset + size == bytes.size()) {
+          jumped = target;
+        } else {
+          return {SaveAndJumpReject::kBranch};
+        }
+        shape.jump_size += static_cast<uint32_t>(size);
+      } else {
+        // Straight-line code must come before the branches.
+        if (shape.jump_size > 0) return {SaveAndJumpReject::kBranch};
+        if (desc.isTrap() || name.starts_with("SYSCALL") ||
+            name.starts_with("SYSENTER") || name.starts_with("INT") ||
+            name.starts_with("UD") || name == "HLT")
+          return {SaveAndJumpReject::kSystem};
+        if (Touches(*inst, desc, r11_)) return {SaveAndJumpReject::kR11};
+        if (OperandsOverlap(*inst, 0, inst->getNumOperands(), rip_))
+          return {SaveAndJumpReject::kRipRelative};
+        if (Defines(*inst, desc, rsp_)) return {SaveAndJumpReject::kStackPointer};
+        touches_r10 = touches_r10 || Touches(*inst, desc, r10_);
+      }
+      offset += size;
+    }
+    if (shape.jump_size == bytes.size()) return {SaveAndJumpReject::kJumpOnly};
+    // A two-exit fold passes its second exit in %r10.
+    if (shape.two_exit && touches_r10) return {SaveAndJumpReject::kR10};
+    std::optional<uint64_t> next = jumped;  // The unconditional exit.
+    if (!next.has_value()) {
+      if (!can_fall_through) return {SaveAndJumpReject::kNoSuccessor};
+      next = address + bytes.size();
+    }
+    // Every exit must be another, non-EH-pad block of the same function; a
+    // `jmp` out of the function is a tail call.
+    const auto is_block = [&](uint64_t exit) {
+      const auto it = block_at.find(exit);
+      return exit != address && it != block_at.end() &&
+             !it->second->is_eh_pad();
+    };
+    if (!is_block(*next) ||
+        (shape.two_exit && (!is_block(*taken) || *taken == *next)))
+      return {SaveAndJumpReject::kNoSuccessor};
+    return shape;
+  }
+
+ private:
+  llvm::MCRegister FindRegister(llvm::StringRef name) const {
+    for (unsigned reg = 1, e = mri_.getNumRegs(); reg < e; ++reg)
+      if (name == mri_.getName(reg)) return llvm::MCRegister(reg);
+    return llvm::MCRegister();
+  }
+
+  // True if a register operand in [begin, end) is or overlaps `reg`.
+  bool OperandsOverlap(const llvm::MCInst& inst, unsigned begin, unsigned end,
+                       llvm::MCRegister reg) const {
+    for (unsigned i = begin; i < end && i < inst.getNumOperands(); ++i) {
+      const llvm::MCOperand& op = inst.getOperand(i);
+      if (op.isReg() && op.getReg().isValid() &&
+          mri_.regsOverlap(op.getReg(), reg))
+        return true;
+    }
+    return false;
+  }
+
+  bool ImplicitOverlap(llvm::ArrayRef<llvm::MCPhysReg> regs,
+                       llvm::MCRegister reg) const {
+    for (llvm::MCPhysReg r : regs)
+      if (mri_.regsOverlap(r, reg)) return true;
+    return false;
+  }
+
+  // Reads or writes `reg`, explicitly or implicitly.
+  bool Touches(const llvm::MCInst& inst, const llvm::MCInstrDesc& desc,
+               llvm::MCRegister reg) const {
+    return OperandsOverlap(inst, 0, inst.getNumOperands(), reg) ||
+           ImplicitOverlap(desc.implicit_uses(), reg) ||
+           ImplicitOverlap(desc.implicit_defs(), reg);
+  }
+
+  // Writes `reg`, explicitly or implicitly.
+  bool Defines(const llvm::MCInst& inst, const llvm::MCInstrDesc& desc,
+               llvm::MCRegister reg) const {
+    return OperandsOverlap(inst, 0, desc.getNumDefs(), reg) ||
+           ImplicitOverlap(desc.implicit_defs(), reg);
+  }
+
+  MiniDisassembler& disassembler_;
+  const llvm::MCInstrInfo& mii_;
+  const llvm::MCRegisterInfo& mri_;
+  const llvm::MCRegister r10_;
+  const llvm::MCRegister r11_;
+  const llvm::MCRegister rip_;
+  const llvm::MCRegister rsp_;
+};
+
+// Size of a Save-and-Jump fold site, or 0 if the backend cannot apply
+// Save-and-Jump on the target. Only x86-64 has link register hooks (%r11,
+// %r10): `leaq Succ(%rip),%r11` (7) + `jmp DeduBB.master.sj.K` (5).
+int SaveAndJumpPatchSize(const BinaryContent& binary_content) {
+  return binary_content.object_file->getArch() == llvm::Triple::x86_64 ? 12
+                                                                         : 0;
+}
+
+// Two-exit Save-and-Jump on x86-64. A fold is `leaq T(%rip),%r11;
+// leaq F(%rip),%r10; jmp DeduBB.master.sj2.K` (7 + 7 + 5). The master grows by
+// the two `leaq` placed in front of it (14) plus `j<cc> 1f; jmp *%r10;
+// 1: jmp *%r11` (2 + 3 + 3), minus its own branches.
+constexpr int kSaveAndJump2PatchSize = 19;
+constexpr int kSaveAndJump2MasterOverhead = 22;
+
+// Save-and-Jump candidates, split by the number of exits.
+struct SaveAndJumpCandidates {
+  std::vector<SaveAndJumpBlock> single_exit;
+  std::vector<SaveAndJumpBlock> two_exit;
+};
+
+// Builds the Save-and-Jump candidates. Each candidate's `bytes` exclude its
+// branches: the master returns through %r11 (and %r10) to whatever blocks the
+// fold names, so only the body, and the branch condition, have to match.
+SaveAndJumpCandidates BuildSaveAndJumpBlocks(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    bool cold_only, bool skip_aliased_functions, SaveAndJumpScanStats& stats) {
+  SaveAndJumpCandidates candidates;
+  absl::StatusOr<std::unique_ptr<MiniDisassembler>> disassembler =
+      MiniDisassembler::Create(binary_content.object_file.get());
+  if (!disassembler.ok()) {
+    LOG(WARNING) << "DeduBB save-and-jump skipped: "
+                 << disassembler.status().message();
+    return candidates;
+  }
+  const SaveAndJumpAnalyzer analyzer(**disassembler);
+  if (!analyzer.IsValid()) {
+    LOG(WARNING) << "DeduBB save-and-jump skipped: R10/R11/RIP/RSP not found";
+    return candidates;
+  }
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps()) {
+    for (const FunctionBbAddrMapPb& function :
+         module.function_bb_addr_maps()) {
+      if (skip_aliased_functions && IsAliased(function)) continue;
+      const std::string function_name =
+          function.function_names().empty()
+              ? std::string(absl::StrFormat("0x%lx", function.function_address()))
+              : std::string(function.function_names(0));
+      std::unordered_map<uint64_t, const BbEntryPb*> block_at;
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          block_at.emplace(bb_range.base_address() + bb_entry.offset(),
+                           &bb_entry);
+        }
+      }
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          const uint64_t address = bb_range.base_address() + bb_entry.offset();
+          // Tail-call and return blocks are Case I. The entry block holds the
+          // prologue and cannot host an in-place master.
+          if (bb_entry.has_return() || bb_entry.has_tail_call()) continue;
+          if (address == function.function_address()) continue;
+          if (bb_entry.size() == 0) continue;
+          if (bb_entry.is_eh_pad()) continue;
+          if (cold_only && (bb_entry.post_link_frequency() > 0 || bb_entry.frequency() > 0)) continue;
+
+          ++stats.scanned;
+          SaveAndJumpShape shape;
+          std::vector<uint8_t> bytes;
+          if (bb_entry.has_indirect_branch()) {
+            shape.reject = SaveAndJumpReject::kBranch;
+          } else if (bb_entry.callsites_size() > 0) {
+            shape.reject = SaveAndJumpReject::kCall;
+          } else {
+            absl::StatusOr<std::vector<uint8_t>> block_bytes = GetBlockBytes(
+                *binary_content.object_file, address, bb_entry.size());
+            if (block_bytes.ok()) {
+              bytes = *std::move(block_bytes);
+              shape = analyzer.Analyze(bytes, address,
+                                       bb_entry.can_fall_through(), block_at);
+            } else {
+              LOG(WARNING) << "Skipping block " << function_name << "#"
+                           << bb_entry.id() << ": "
+                           << block_bytes.status().message();
+              shape.reject = SaveAndJumpReject::kDecodeError;
+            }
+          }
+          ++stats.by_reason[static_cast<int>(shape.reject)];
+          if (shape.reject != SaveAndJumpReject::kNone) continue;
+          bytes.resize(bytes.size() - shape.jump_size);
+
+          std::string mod_name = std::string(module.module_name());
+          if (mod_name.empty()) {
+            size_t uniq_pos = function_name.find(".__uniq.");
+            if (uniq_pos != std::string::npos) {
+              mod_name = function_name.substr(uniq_pos + 8);
+            }
+          }
+          (shape.two_exit ? candidates.two_exit : candidates.single_exit)
+              .push_back(SaveAndJumpBlock{mod_name, function_name,
+                                         bb_entry.id(), address,
+                                         std::max(static_cast<uint64_t>(bb_entry.post_link_frequency()), static_cast<uint64_t>(bb_entry.frequency())),
+                                         std::move(bytes), shape.jump_size,
+                                         shape.condition});
+        }
+      }
+    }
+  }
+  return candidates;
+}
+
+std::string FormatRejects(const SaveAndJumpScanStats& stats) {
+  std::string out;
+  for (int i = 1; i < static_cast<int>(SaveAndJumpReject::kNumReasons); ++i) {
+    absl::StrAppendFormat(&out, "%s%s=%d", out.empty() ? "" : ", ",
+                          kSaveAndJumpRejectNames[i], stats.by_reason[i]);
+  }
+  return out;
+}
+
+// Why a block is not a Call-Return candidate. The compiler emits each master
+// from the bytes checked here, and replaces a block only if its own
+// instructions match them (llvm/lib/CodeGen/DeduBBCallReturn.cpp). So these
+// checks decide what the masters do; the compiler's checks only decide which
+// blocks use them. Code the linker rewrites is refused here, since no block's
+// instructions would match it.
+enum class CallReturnReject {
+  kNone,
+  kBranch,          // A branch in the body, or trailing branches that are not
+                    // the jumps a block ends with.
+  kStackPointer,    // Reads or writes %rsp (or the shadow-stack pointer) other
+                    // than as a call's return address: the master runs with
+                    // %rsp 8 or 16 bytes lower.
+  kRipRelative,     // A %rip-relative or absolute address, other than a
+                    // direct call's target.
+  kSystem,          // syscall, int, ud, hlt, endbr, a far call, a call the
+                    // callee identifies by its return address (mcount).
+  kUnresolvedCall,  // A direct call whose target has no function or PLT
+                    // symbol to check the compiler's call against.
+  kReturnsTwice,    // Calls setjmp, vfork or the like, which would save the
+                    // master's frame.
+  kTls,             // Addresses memory through %fs or %gs: thread-local
+                    // storage, whose code the linker rewrites (a call to
+                    // __tls_get_addr becomes `mov %fs:0,%rax`).
+  kPrefixedCall,    // A direct call with a prefix, as the linker writes for a
+                    // call through the GOT (`addr32 call`).
+  kRedZone,         // The function keeps data below %rsp (the x86-64 red
+                    // zone), where the stub's `call` writes.
+  kEmpty,           // Nothing but branches: no body to share.
+  kDecodeError,
+  kNumReasons,
+};
+
+constexpr std::array<const char*,
+                     static_cast<int>(CallReturnReject::kNumReasons)>
+    kCallReturnRejectNames = {"eligible",        "branch",
+                              "rsp",             "rip-relative",
+                              "system",          "unresolved-call",
+                              "returns-twice",   "tls",
+                              "prefixed-call",   "red-zone",
+                              "empty",           "decode-error"};
+
+struct CallReturnScanStats {
+  int64_t scanned = 0;
+  int64_t red_zone_functions = 0;
+  std::array<int64_t, static_cast<int>(CallReturnReject::kNumReasons)>
+      by_reason{};
+};
+
+std::string FormatRejects(const CallReturnScanStats& stats) {
+  std::string out;
+  for (int i = 1; i < static_cast<int>(CallReturnReject::kNumReasons); ++i) {
+    absl::StrAppendFormat(&out, "%s%s=%d", out.empty() ? "" : ", ",
+                          kCallReturnRejectNames[i], stats.by_reason[i]);
+  }
+  return out;
+}
+
+struct DecodedInst {
+  llvm::MCInst inst;
+  uint32_t offset = 0;  // From the start of the block.
+  uint32_t size = 0;
+};
+
+// True if `name` can be written into a directive line as one callee name.
+bool IsPlainSymbolName(llvm::StringRef name) {
+  if (name.empty()) return false;
+  for (char c : name)
+    if (c <= ' ' || c == ',' || c == '|' || c == '(' || c == ')' || c == 0x7f)
+      return false;
+  return true;
+}
+
+// Maps each function start to the names the compiler may call it by: all
+// function symbols at that address, '|'-separated, or the symbol a PLT entry
+// resolves to.
+absl::flat_hash_map<uint64_t, std::string> BuildCalleeNames(
+    const BinaryContent& binary_content, const llvm::MCSubtargetInfo& sti) {
+  absl::flat_hash_map<uint64_t, std::string> names;
+  for (const auto& [address, info] : GetSymbolInfoMap(binary_content)) {
+    std::string joined;
+    bool plain = true;
+    for (llvm::StringRef alias : info.aliases) {
+      plain = plain && IsPlainSymbolName(alias);
+      if (!joined.empty()) joined += '|';
+      joined += alias.str();
+    }
+    if (plain && !joined.empty()) names.emplace(address, std::move(joined));
+  }
+  const auto* elf = llvm::dyn_cast<llvm::object::ELFObjectFileBase>(
+      binary_content.object_file.get());
+  if (elf == nullptr) return names;
+  for (const llvm::object::ELFPltEntry& entry : elf->getPltEntries(sti)) {
+    if (!entry.Symbol.has_value()) continue;
+    llvm::Expected<llvm::StringRef> name =
+        llvm::object::SymbolRef(*entry.Symbol, elf).getName();
+    if (!name) {
+      llvm::consumeError(name.takeError());
+      continue;
+    }
+    if (IsPlainSymbolName(*name)) names.try_emplace(entry.Address, name->str());
+  }
+  return names;
+}
+
+// True if any of the '|'-separated `names` is in `set`.
+bool AnyNameIn(llvm::StringRef names,
+               std::initializer_list<llvm::StringRef> set) {
+  llvm::SmallVector<llvm::StringRef, 4> parts;
+  names.split(parts, '|');
+  for (llvm::StringRef part : parts)
+    for (llvm::StringRef name : set)
+      if (part == name) return true;
+  return false;
+}
+
+// Callees that return twice: a call to one from a master would save the
+// master's frame, which is gone once the master returns.
+bool IsReturnsTwice(llvm::StringRef names) {
+  return AnyNameIn(names, {"setjmp", "_setjmp", "__setjmp", "sigsetjmp",
+                           "__sigsetjmp", "savectx", "vfork", "__vfork",
+                           "getcontext", "__getcontext", "qsetjmp"});
+}
+
+// Callees that identify their caller by the return address: moving the call
+// into a master would attribute it to the master.
+bool IsCallerSensitive(llvm::StringRef names) {
+  if (AnyNameIn(names, {"__fentry__", "mcount", "_mcount", "__mcount",
+                        "__cyg_profile_func_enter", "__cyg_profile_func_exit"}))
+    return true;
+  llvm::SmallVector<llvm::StringRef, 4> parts;
+  names.split(parts, '|');
+  for (llvm::StringRef part : parts)
+    if (part.starts_with("__sanitizer_cov") || part.starts_with("__asan_") ||
+        part.starts_with("__tsan_") || part.starts_with("__msan_") ||
+        part.starts_with("__hwasan_"))
+      return true;
+  return false;
+}
+
+// Decides whether a block's body can move into a Call-Return master:
+//
+//   <body>                  the master runs this with %rsp 8 (no call in the
+//   <trailing branches>     body) or 16 bytes lower, so it must not touch %rsp
+//                           other than through calls, must not depend on its
+//                           own address, and must not branch.
+//
+// The trailing branches stay in the block, after the stub.
+class CallReturnAnalyzer {
+ public:
+  CallReturnAnalyzer(
+      MiniDisassembler& disassembler,
+      const absl::flat_hash_map<uint64_t, std::string>& callee_names)
+      : disassembler_(disassembler),
+        mii_(disassembler.instr_info()),
+        mri_(disassembler.register_info()),
+        callee_names_(callee_names),
+        rip_(FindRegister("RIP")),
+        rsp_(FindRegister("RSP")),
+        ssp_(FindRegister("SSP")),
+        fs_(FindRegister("FS")),
+        gs_(FindRegister("GS")) {}
+
+  bool IsValid() const {
+    return rip_.isValid() && rsp_.isValid() && fs_.isValid() && gs_.isValid();
+  }
+
+  // Decodes the block `bytes` at `address` into `insts`. Returns false on a
+  // decode error.
+  bool Decode(llvm::ArrayRef<uint8_t> bytes, uint64_t address,
+              std::vector<DecodedInst>& insts) const {
+    insts.clear();
+    for (uint64_t offset = 0; offset < bytes.size();) {
+      uint64_t size = 0;
+      absl::StatusOr<llvm::MCInst> inst = disassembler_.DisassembleOne(
+          bytes.drop_front(offset), address + offset, size);
+      if (!inst.ok() || size == 0 || offset + size > bytes.size()) return false;
+      insts.push_back({*std::move(inst), static_cast<uint32_t>(offset),
+                       static_cast<uint32_t>(size)});
+      offset += size;
+    }
+    return true;
+  }
+
+  // True if the code keeps data in the red zone below %rsp: a memory operand,
+  // or an address computed by `lea`, at a negative displacement from %rsp.
+  // The compiler only does this in leaf functions, and the backend's own check
+  // (X86MachineFunctionInfo::getUsesRedZone) is authoritative; this only
+  // keeps such blocks available for Save-and-Jump.
+  bool UsesRedZone(const std::vector<DecodedInst>& insts) const {
+    for (const DecodedInst& decoded : insts) {
+      const llvm::MCInst& inst = decoded.inst;
+      const MemoryReference mem = GetMemoryReference(inst);
+      if (mem.kind == MemoryReference::kBaseIndexDisp && mem.base.isValid() &&
+          mri_.regsOverlap(mem.base, rsp_) && mem.disp < 0)
+        return true;
+    }
+    return false;
+  }
+
+  // Classifies the block `insts` (decoded from `bytes` at `address`) and, if
+  // it qualifies, fills in the key, body size, instruction count and callees
+  // of `block`.
+  // `block_at` maps the start address of every block of the function to its
+  // entry.
+  CallReturnReject Analyze(
+      const std::vector<DecodedInst>& insts, llvm::ArrayRef<uint8_t> bytes,
+      uint64_t address,
+      const std::unordered_map<uint64_t, const BbEntryPb*>& block_at,
+      CallReturnBlock& block) const {
+    // Split off the trailing branches: these stay in the block. They must be
+    // what the compiler ends a block with (conditional jumps, then at most one
+    // jump) so that the body here is the part before the compiler's
+    // terminators.
+    size_t body_end = insts.size();
+    int conditional = 0;
+    bool seen_final = false;
+    while (body_end > 0) {
+      const DecodedInst& decoded = insts[body_end - 1];
+      const llvm::MCInstrDesc& desc = mii_.get(decoded.inst.getOpcode());
+      if (desc.isCall() || !(desc.isBranch() || desc.isIndirectBranch())) break;
+      const llvm::StringRef name = mii_.getName(decoded.inst.getOpcode());
+      const bool is_last = body_end == insts.size();
+      if (name == "JCC_1" || name == "JCC_4") {
+        if (++conditional > 2) return CallReturnReject::kBranch;
+      } else if (name == "JMP_1" || name == "JMP_4" || name == "JMP64r" ||
+                 name == "JMP64m" || name == "JMP64r_NT" ||
+                 name == "JMP64m_NT") {
+        if (!is_last || seen_final) return CallReturnReject::kBranch;
+        seen_final = true;
+      } else {
+        return CallReturnReject::kBranch;
+      }
+      // A direct jump must land on the start of a block of this function; a
+      // jump elsewhere is a tail call or a jump into the middle of a block.
+      uint64_t target = 0;
+      if (disassembler_.instr_analysis().evaluateBranch(
+              decoded.inst, address + decoded.offset, decoded.size, target)) {
+        const auto it = block_at.find(target);
+        if (it == block_at.end() || it->second->is_eh_pad())
+          return CallReturnReject::kBranch;
+      } else if (!desc.isIndirectBranch()) {
+        return CallReturnReject::kBranch;
+      }
+      --body_end;
+    }
+    if (body_end == 0) return CallReturnReject::kEmpty;
+
+    block.key.clear();
+    block.callees.clear();
+    block.call_key_offsets.clear();
+    for (size_t i = 0; i < body_end; ++i) {
+      const DecodedInst& decoded = insts[i];
+      const llvm::MCInst& inst = decoded.inst;
+      const llvm::MCInstrDesc& desc = mii_.get(inst.getOpcode());
+      const llvm::StringRef name = mii_.getName(inst.getOpcode());
+      const llvm::ArrayRef<uint8_t> inst_bytes =
+          bytes.slice(decoded.offset, decoded.size);
+      if (IsSystem(desc, name)) return CallReturnReject::kSystem;
+      if (desc.isCall()) {
+        if (name == "CALL64pcrel32") {
+          // The master calls its target by name, with `call rel32`.
+          if (inst_bytes.size() != 5 || inst_bytes[0] != 0xe8)
+            return CallReturnReject::kPrefixedCall;
+          uint64_t target = 0;
+          if (!disassembler_.instr_analysis().evaluateBranch(
+                  inst, address + decoded.offset, decoded.size, target))
+            return CallReturnReject::kDecodeError;
+          const auto it = callee_names_.find(target);
+          if (it == callee_names_.end())
+            return CallReturnReject::kUnresolvedCall;
+          if (IsReturnsTwice(it->second))
+            return CallReturnReject::kReturnsTwice;
+          if (IsCallerSensitive(it->second)) return CallReturnReject::kSystem;
+          block.callees.push_back(it->second);
+          block.call_key_offsets.push_back(
+              static_cast<uint32_t>(block.key.size()));
+          AppendDirectCallToKey(block.key, inst_bytes.data(),
+                                inst_bytes.size(), target);
+          continue;
+        }
+        if (name == "CALL64r" || name == "CALL64m" || name == "CALL64r_NT" ||
+            name == "CALL64m_NT") {
+          // Through a register or memory: the address must not depend on
+          // %rsp or %rip either.
+          if (OperandsOverlap(inst, rsp_) ||
+              (ssp_.isValid() && OperandsOverlap(inst, ssp_)))
+            return CallReturnReject::kStackPointer;
+          if (OperandsOverlap(inst, rip_) || IsAbsolute(inst))
+            return CallReturnReject::kRipRelative;
+          if (UsesTlsSegment(inst)) return CallReturnReject::kTls;
+          block.callees.push_back("*");
+          block.key.insert(block.key.end(), inst_bytes.begin(),
+                           inst_bytes.end());
+          continue;
+        }
+        return CallReturnReject::kSystem;
+      }
+      if (desc.mayAffectControlFlow(inst, mri_) || desc.isBranch() ||
+          desc.isIndirectBranch() || desc.isReturn())
+        return CallReturnReject::kBranch;
+      if (Touches(inst, desc, rsp_) ||
+          (ssp_.isValid() && Touches(inst, desc, ssp_)) ||
+          name.starts_with("RDSSP") || name.starts_with("INCSSP") ||
+          name.starts_with("SAVEPREVSSP") || name.starts_with("RSTORSSP") ||
+          name.starts_with("WRSS") || name.starts_with("WRUSS") ||
+          name.starts_with("SETSSBSY") || name.starts_with("CLRSSBSY"))
+        return CallReturnReject::kStackPointer;
+      if (OperandsOverlap(inst, rip_) || IsAbsolute(inst))
+        return CallReturnReject::kRipRelative;
+      if (UsesTlsSegment(inst)) return CallReturnReject::kTls;
+      block.key.insert(block.key.end(), inst_bytes.begin(), inst_bytes.end());
+    }
+    block.body_size = insts[body_end - 1].offset + insts[body_end - 1].size;
+    block.inst_count = static_cast<uint32_t>(body_end);
+    return CallReturnReject::kNone;
+  }
+
+ private:
+  // A decoded memory reference: `seg:disp(base,index,scale)`, or an absolute
+  // `seg:disp` (the moffs forms of `mov`).
+  struct MemoryReference {
+    enum Kind { kNone, kBaseIndexDisp, kOffset, kOther } kind = kNone;
+    llvm::MCRegister base;
+    llvm::MCRegister index;
+    llvm::MCRegister segment;
+    int64_t disp = 0;
+  };
+
+  MemoryReference GetMemoryReference(const llvm::MCInst& inst) const {
+    MemoryReference mem;
+    const llvm::MCInstrDesc& desc = mii_.get(inst.getOpcode());
+    const llvm::StringRef name = mii_.getName(inst.getOpcode());
+    int start = -1;
+    // `lea`'s address operand is not typed as memory.
+    if (name.starts_with("LEA16r") || name.starts_with("LEA32r") ||
+        name.starts_with("LEA64r") || name.starts_with("LEA64_32r")) {
+      start = 1;
+    } else {
+      for (unsigned i = 0; i < desc.getNumOperands(); ++i) {
+        if (desc.operands()[i].OperandType == llvm::MCOI::OPERAND_MEMORY) {
+          start = static_cast<int>(i);
+          break;
+        }
+      }
+    }
+    if (start < 0) return mem;
+    const unsigned n = inst.getNumOperands();
+    const auto op = [&](unsigned i) -> const llvm::MCOperand& {
+      return inst.getOperand(i);
+    };
+    const unsigned s = static_cast<unsigned>(start);
+    if (s + 4 < n && op(s).isReg() && op(s + 1).isImm() && op(s + 2).isReg() &&
+        op(s + 4).isReg()) {
+      mem.kind = MemoryReference::kBaseIndexDisp;
+      mem.base = op(s).getReg();
+      mem.index = op(s + 2).getReg();
+      mem.segment = op(s + 4).getReg();
+      if (op(s + 3).isImm())
+        mem.disp = op(s + 3).getImm();
+      else
+        mem.kind = MemoryReference::kOther;
+      return mem;
+    }
+    if (s + 1 < n && op(s).isImm() && op(s + 1).isReg()) {
+      mem.kind = MemoryReference::kOffset;
+      mem.disp = op(s).getImm();
+      mem.segment = op(s + 1).getReg();
+      return mem;
+    }
+    // String instructions address through %rsi/%rdi.
+    if (op(s).isReg()) return mem;
+    mem.kind = MemoryReference::kOther;
+    return mem;
+  }
+
+  // True if the instruction addresses memory through %fs or %gs.
+  bool UsesTlsSegment(const llvm::MCInst& inst) const {
+    const MemoryReference mem = GetMemoryReference(inst);
+    return mem.segment.isValid() && (mri_.regsOverlap(mem.segment, fs_) ||
+                                     mri_.regsOverlap(mem.segment, gs_));
+  }
+
+  // True if the instruction addresses memory by an absolute address, which is
+  // only position independent in a non-PIC binary: no base register and no
+  // segment override.
+  bool IsAbsolute(const llvm::MCInst& inst) const {
+    const MemoryReference mem = GetMemoryReference(inst);
+    switch (mem.kind) {
+      case MemoryReference::kNone:
+        return false;
+      case MemoryReference::kBaseIndexDisp:
+        return !mem.base.isValid() && !mem.segment.isValid();
+      case MemoryReference::kOffset:
+        return !mem.segment.isValid();
+      case MemoryReference::kOther:
+        return true;
+    }
+    return true;
+  }
+
+  static bool IsSystem(const llvm::MCInstrDesc& desc, llvm::StringRef name) {
+    return desc.isTrap() || name.starts_with("SYSCALL") ||
+           name.starts_with("SYSENTER") || name.starts_with("SYSEXIT") ||
+           name.starts_with("SYSRET") || name.starts_with("INT") ||
+           name.starts_with("UD") || name == "TRAP" || name == "HLT" ||
+           name.starts_with("ENDBR") || name.starts_with("IRET") ||
+           name == "VMCALL" || name == "VMMCALL" || name == "VMLAUNCH" ||
+           name == "VMRESUME" || name.starts_with("VMRUN") ||
+           name == "VMFUNC" || name.starts_with("ENCL") ||
+           name == "TDCALL" || name.starts_with("SEAM") ||
+           name == "UIRET" || name.starts_with("XBEGIN") ||
+           name.starts_with("XABORT") || name.starts_with("FAR");
+  }
+
+  llvm::MCRegister FindRegister(llvm::StringRef name) const {
+    for (unsigned reg = 1, e = mri_.getNumRegs(); reg < e; ++reg)
+      if (name == mri_.getName(reg)) return llvm::MCRegister(reg);
+    return llvm::MCRegister();
+  }
+
+  // True if an explicit register operand is or overlaps `reg`.
+  bool OperandsOverlap(const llvm::MCInst& inst, llvm::MCRegister reg) const {
+    for (const llvm::MCOperand& op : inst) {
+      if (op.isReg() && op.getReg().isValid() &&
+          mri_.regsOverlap(op.getReg(), reg))
+        return true;
+    }
+    return false;
+  }
+
+  // Reads or writes `reg`, explicitly or implicitly.
+  bool Touches(const llvm::MCInst& inst, const llvm::MCInstrDesc& desc,
+               llvm::MCRegister reg) const {
+    if (OperandsOverlap(inst, reg)) return true;
+    for (llvm::MCPhysReg r : desc.implicit_uses())
+      if (mri_.regsOverlap(r, reg)) return true;
+    for (llvm::MCPhysReg r : desc.implicit_defs())
+      if (mri_.regsOverlap(r, reg)) return true;
+    return false;
+  }
+
+  MiniDisassembler& disassembler_;
+  const llvm::MCInstrInfo& mii_;
+  const llvm::MCRegisterInfo& mri_;
+  const absl::flat_hash_map<uint64_t, std::string>& callee_names_;
+  const llvm::MCRegister rip_;
+  const llvm::MCRegister rsp_;
+  const llvm::MCRegister ssp_;
+  const llvm::MCRegister fs_;
+  const llvm::MCRegister gs_;
+};
+
+// Builds the Call-Return candidates. Every block of a function qualifies
+// except its entry block (which holds the prologue and entry
+// instrumentation), blocks that end in a return or a tail call (those are
+// tail-call folds), EH pads, and functions named `DeduBB.*` (the masters of a
+// previous run).
+std::vector<CallReturnBlock> BuildCallReturnBlocks(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    bool cold_only, bool skip_aliased_functions, CallReturnScanStats& stats) {
+  std::vector<CallReturnBlock> candidates;
+  absl::StatusOr<std::unique_ptr<MiniDisassembler>> disassembler =
+      MiniDisassembler::Create(binary_content.object_file.get());
+  if (!disassembler.ok()) {
+    LOG(WARNING) << "DeduBB call-return skipped: "
+                 << disassembler.status().message();
+    return candidates;
+  }
+  const absl::flat_hash_map<uint64_t, std::string> callee_names =
+      BuildCalleeNames(binary_content, (*disassembler)->subtarget_info());
+  const CallReturnAnalyzer analyzer(**disassembler, callee_names);
+  if (!analyzer.IsValid()) {
+    LOG(WARNING) << "DeduBB call-return skipped: RIP/RSP/FS/GS not found";
+    return candidates;
+  }
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps()) {
+    for (const FunctionBbAddrMapPb& function :
+         module.function_bb_addr_maps()) {
+      if (skip_aliased_functions && IsAliased(function)) continue;
+      const std::string function_name =
+          function.function_names().empty()
+              ? std::string(absl::StrFormat("0x%lx", function.function_address()))
+              : std::string(function.function_names(0));
+      if (llvm::StringRef(function_name).starts_with("DeduBB.")) continue;
+      std::unordered_map<uint64_t, const BbEntryPb*> block_at;
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          block_at.emplace(bb_range.base_address() + bb_entry.offset(),
+                           &bb_entry);
+        }
+      }
+      // Decode the whole function once: the red-zone check needs every block.
+      struct Decoded {
+        const BbEntryPb* entry;
+        uint64_t address;
+        std::vector<uint8_t> bytes;
+        std::vector<DecodedInst> insts;
+        bool ok;
+      };
+      std::vector<Decoded> decoded;
+      bool red_zone = false;
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          if (bb_entry.size() == 0) continue;
+          const uint64_t address = bb_range.base_address() + bb_entry.offset();
+          Decoded d{&bb_entry, address, {}, {}, false};
+          absl::StatusOr<std::vector<uint8_t>> block_bytes = GetBlockBytes(
+              *binary_content.object_file, address, bb_entry.size());
+          if (block_bytes.ok()) {
+            d.bytes = *std::move(block_bytes);
+            d.ok = analyzer.Decode(d.bytes, address, d.insts);
+          }
+          // An undecodable block might keep data in the red zone too.
+          red_zone = red_zone || !d.ok || analyzer.UsesRedZone(d.insts);
+          decoded.push_back(std::move(d));
+        }
+      }
+      stats.red_zone_functions += red_zone;
+
+      std::string mod_name = std::string(module.module_name());
+      if (mod_name.empty()) {
+        size_t uniq_pos = function_name.find(".__uniq.");
+        if (uniq_pos != std::string::npos) {
+          mod_name = function_name.substr(uniq_pos + 8);
+        }
+      }
+      for (const Decoded& d : decoded) {
+        const BbEntryPb& bb_entry = *d.entry;
+        if (bb_entry.has_return() || bb_entry.has_tail_call()) continue;
+        if (d.address == function.function_address()) continue;
+        if (bb_entry.is_eh_pad()) continue;
+        if (cold_only && (bb_entry.post_link_frequency() > 0 ||
+                          bb_entry.frequency() > 0))
+          continue;
+        ++stats.scanned;
+        CallReturnBlock block;
+        CallReturnReject reject = CallReturnReject::kNone;
+        if (!d.ok) {
+          reject = CallReturnReject::kDecodeError;
+        } else {
+          reject = analyzer.Analyze(d.insts, d.bytes, d.address, block_at,
+                                    block);
+          if (reject == CallReturnReject::kNone && red_zone)
+            reject = CallReturnReject::kRedZone;
+        }
+        ++stats.by_reason[static_cast<int>(reject)];
+        if (reject != CallReturnReject::kNone) continue;
+        block.module_name = mod_name;
+        block.function_name = function_name;
+        block.bb_id = bb_entry.id();
+        block.address = d.address;
+        block.frequency =
+            std::max(static_cast<uint64_t>(bb_entry.post_link_frequency()),
+                     static_cast<uint64_t>(bb_entry.frequency()));
+        candidates.push_back(std::move(block));
+      }
+    }
+  }
+  return candidates;
+}
+
+}  // namespace
+
+absl::Status WriteTailCallDedupProfile(const PropellerOptions& opts) {
+  if (opts.dedubb_profile_out_name().empty()) return absl::OkStatus();
+
+  ASSIGN_OR_RETURN(std::unique_ptr<BinaryContent> binary_content,
+                   GetBinaryContent(opts.binary_name()));
+
+  // `GetBbAddrMap` decodes the `SHT_LLVM_BB_ADDR_MAP` section into a proto with
+  // module names (via DWARF), function names (via the symbol table), and the
+  // per-block tail-call/return flags we need.
+  const BbAddrMapPb bb_addr_map = GetBbAddrMap(opts.binary_name());
+
+  if (opts.dedubb_skip_aliased_functions()) {
+    int64_t aliased = 0;
+    for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps())
+      for (const FunctionBbAddrMapPb& function : module.function_bb_addr_maps())
+        aliased += IsAliased(function);
+    LOG(INFO) << "DeduBB: skipping " << aliased
+              << " function(s) whose address carries more than one name "
+                 "(aliases or identical-code-folded functions)";
+  }
+
+  std::vector<TailCallBlock> blocks =
+      BuildTailCallBlocks(bb_addr_map, *binary_content, opts.dedubb_cold_only(),
+                          opts.dedubb_skip_aliased_functions());
+
+  SaveAndJumpScanStats sj_stats;
+  SaveAndJumpCandidates sj_blocks;
+  const int sj_patch_size = SaveAndJumpPatchSize(*binary_content);
+  if (sj_patch_size > 0) {
+    sj_blocks = BuildSaveAndJumpBlocks(bb_addr_map, *binary_content,
+                                       opts.dedubb_cold_only(),
+                                       opts.dedubb_skip_aliased_functions(),
+                                       sj_stats);
+  } else {
+    LOG(INFO) << "DeduBB save-and-jump: not supported for this target";
+  }
+
+  // Call-Return (x86-64 only). With `dedubb_call_return` its groups are formed
+  // first and their blocks are withheld from Save-and-Jump: for a block that
+  // qualifies for both, a Call-Return stub is smaller (5 or 11 bytes against
+  // 12 or 19) and its master costs one byte instead of 10 or 22.
+  // `dedubb_call_return_estimate` only logs what that would do.
+  const bool call_return = opts.dedubb_call_return();
+  const bool call_return_estimate =
+      call_return || opts.dedubb_call_return_estimate();
+  CallReturnScanStats cr_stats;
+  std::vector<CallReturnBlock> cr_blocks;
+  if (call_return_estimate) {
+    if (binary_content->object_file->getArch() == llvm::Triple::x86_64) {
+      cr_blocks = BuildCallReturnBlocks(
+          bb_addr_map, *binary_content, opts.dedubb_cold_only(),
+          opts.dedubb_skip_aliased_functions(), cr_stats);
+    } else {
+      LOG(INFO) << "DeduBB call-return: not supported for this target";
+    }
+  }
+  CallReturnDedupOptions cr_options;
+  cr_options.intra_module_only = opts.dedubb_intra_module_only();
+  CallReturnDedupResult cr_result =
+      DeduplicateCallReturnBlocks(cr_blocks, cr_options);
+
+  TailCallDedupOptions dedup_options;
+  dedup_options.patch_size = TailCallPatchSize(*binary_content);
+  dedup_options.intra_module_only = opts.dedubb_intra_module_only();
+  const TailCallDedupResult result =
+      DeduplicateTailCallBlocks(blocks, dedup_options);
+
+  // Save-and-Jump, on all of its candidates and on those Call-Return leaves.
+  SaveAndJumpDedupOptions sj_options;
+  sj_options.patch_size = sj_patch_size;
+  sj_options.intra_module_only = opts.dedubb_intra_module_only();
+  SaveAndJumpDedupOptions sj2_options;
+  sj2_options.patch_size = kSaveAndJump2PatchSize;
+  sj2_options.master_overhead = kSaveAndJump2MasterOverhead;
+  sj2_options.intra_module_only = opts.dedubb_intra_module_only();
+  sj2_options.two_exit = true;
+  const std::vector<SaveAndJumpBlock> sj_left =
+      RemoveBlocksAt(sj_blocks.single_exit, cr_result.stub_addresses);
+  const std::vector<SaveAndJumpBlock> sj2_left =
+      RemoveBlocksAt(sj_blocks.two_exit, cr_result.stub_addresses);
+  const auto run_save_and_jump = [&](bool hybrid, SaveAndJumpDedupResult& sj,
+                                     SaveAndJumpDedupResult& sj2) {
+    sj_options.first_master_id = result.num_masters;
+    sj = DeduplicateSaveAndJumpBlocks(hybrid ? sj_left : sj_blocks.single_exit,
+                                      sj_options);
+    sj2_options.first_master_id = sj_options.first_master_id + sj.num_masters;
+    sj2 = DeduplicateSaveAndJumpBlocks(hybrid ? sj2_left : sj_blocks.two_exit,
+                                       sj2_options);
+    return sj2_options.first_master_id + sj2.num_masters;
+  };
+  // Save-and-Jump on its own, and next to Call-Return (the same if there are
+  // no Call-Return candidates).
+  SaveAndJumpDedupResult sj_alone, sj2_alone, sj_hybrid, sj2_hybrid;
+  const uint64_t next_id_alone =
+      run_save_and_jump(/*hybrid=*/false, sj_alone, sj2_alone);
+  const uint64_t next_id_hybrid =
+      call_return_estimate
+          ? run_save_and_jump(/*hybrid=*/true, sj_hybrid, sj2_hybrid)
+          : next_id_alone;
+  if (!call_return_estimate) {
+    sj_hybrid = sj_alone;
+    sj2_hybrid = sj2_alone;
+  }
+  const SaveAndJumpDedupResult& sj_result = call_return ? sj_hybrid : sj_alone;
+  const SaveAndJumpDedupResult& sj2_result =
+      call_return ? sj2_hybrid : sj2_alone;
+  // Call-Return masters are numbered after the two-exit Save-and-Jump ones.
+  OffsetCallReturnMasterIds(cr_result, next_id_hybrid);
+
+  const std::string out_path(opts.dedubb_profile_out_name());
+  std::ofstream out(out_path, std::ofstream::out | std::ofstream::trunc);
+  out << FormatDirectives(result);
+  out << FormatSaveAndJumpDirectives(sj_result);
+  out << FormatSaveAndJumpDirectives(sj2_result);
+  if (call_return) out << FormatCallReturnDirectives(cr_result);
+  if (!out) {
+    return absl::UnavailableError(
+        absl::StrFormat("Failed to write DeduBB directives to '%s'", out_path));
+  }
+
+  LOG(INFO) << "DeduBB tail-call dedup: " << blocks.size()
+            << " candidate blocks, " << result.num_groups << " master group(s), "
+            << result.num_folds << " fold(s), ~" << result.bytes_saved
+            << " bytes saved; wrote " << opts.dedubb_profile_out_name();
+  LOG(INFO) << "DeduBB save-and-jump: " << sj_stats.scanned
+            << " blocks scanned; rejected: " << FormatRejects(sj_stats);
+  LOG(INFO) << "DeduBB save-and-jump, one exit: "
+            << sj_blocks.single_exit.size() << " eligible, "
+            << sj_result.num_groups << " master group(s), "
+            << sj_result.num_folds << " fold(s), ~" << sj_result.bytes_saved
+            << " bytes saved";
+  LOG(INFO) << "DeduBB save-and-jump, two exits: "
+            << sj_blocks.two_exit.size() << " eligible, "
+            << sj2_result.num_groups << " master group(s), "
+            << sj2_result.num_folds << " fold(s), ~" << sj2_result.bytes_saved
+            << " bytes saved";
+  if (!call_return_estimate) return absl::OkStatus();
+
+  int64_t eligible_with_calls = 0;
+  for (const CallReturnBlock& block : cr_blocks)
+    eligible_with_calls += !block.callees.empty();
+  // The compiler puts each module's masters in one function with one unwind
+  // table entry, about 32 bytes of .eh_frame and .eh_frame_hdr, which
+  // llvm-size counts as text.
+  constexpr int64_t kFdeBytes = 32;
+  const int64_t cr_with_fdes =
+      cr_result.bytes_saved - kFdeBytes * cr_result.num_master_modules;
+  const size_t sj_taken = sj_blocks.single_exit.size() - sj_left.size();
+  const size_t sj2_taken = sj_blocks.two_exit.size() - sj2_left.size();
+  LOG(INFO) << "DeduBB call-return" << (call_return ? "" : " (estimate only)")
+            << ": " << cr_stats.scanned << " blocks scanned, "
+            << cr_stats.red_zone_functions
+            << " red-zone function(s); rejected: " << FormatRejects(cr_stats);
+  LOG(INFO) << "DeduBB call-return, no call in the body: "
+            << cr_blocks.size() - eligible_with_calls << " eligible, "
+            << cr_result.num_groups - cr_result.num_groups_with_calls
+            << " master group(s), "
+            << cr_result.num_stubs - cr_result.num_stubs_with_calls
+            << " stub(s)";
+  LOG(INFO) << "DeduBB call-return, calls in the body: " << eligible_with_calls
+            << " eligible, " << cr_result.num_groups_with_calls
+            << " master group(s), " << cr_result.num_stubs_with_calls
+            << " stub(s)";
+  LOG(INFO) << "DeduBB call-return: ~" << cr_result.bytes_saved
+            << " bytes saved in .text; masters in "
+            << cr_result.num_master_modules << " module(s), ~" << cr_with_fdes
+            << " bytes with one FDE each";
+  LOG(INFO) << "DeduBB hybrid: call-return takes " << sj_taken
+            << " one-exit and " << sj2_taken
+            << " two-exit save-and-jump candidates; save-and-jump then saves ~"
+            << sj_hybrid.bytes_saved << " + ~" << sj2_hybrid.bytes_saved
+            << " bytes (alone: ~" << sj_alone.bytes_saved << " + ~"
+            << sj2_alone.bytes_saved << ")";
+  LOG(INFO) << "DeduBB total with call-return: ~"
+            << result.bytes_saved + sj_hybrid.bytes_saved +
+                   sj2_hybrid.bytes_saved + cr_result.bytes_saved
+            << " bytes in .text (without: ~"
+            << result.bytes_saved + sj_alone.bytes_saved +
+                   sj2_alone.bytes_saved
+            << ")";
+  if (!call_return)
+    LOG(INFO) << "DeduBB call-return: estimate only, no call-return "
+                 "directives written (use --dedubb_call_return)";
+  return absl::OkStatus();
+}
+
+}  // namespace propeller
