+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef PROPELLER_CALL_RETURN_DEDUPPER_H_
+#define PROPELLER_CALL_RETURN_DEDUPPER_H_
+
+// DeduBB Call-Return deduplication core.
+//
+// Outlines the *body* of byte-identical blocks, everything before their
+// trailing branches, into one shared master routine that ends in `ret`. On
+// x86-64 every member of a group, the master's own block included, becomes
+//
+//   call DeduBB.master.cr.K                          (no call in the body)
+//   push %rax; call DeduBB.master.cr.K; lea 8(%rsp),%rsp   (calls in the body)
+//
+// followed by its original, unchanged branches. The second form keeps the
+// stack 16-byte aligned for the calls inside the master; `push`, `call`, `ret`
+// and `lea` leave EFLAGS alone. The compiler emits the masters in a separate
+// function per module (`DeduBB.cr.masters`) with its own unwind info.
+//
+// A body qualifies only if it is position independent and runs unchanged with
+// %rsp 8 or 16 bytes lower: no %rsp or %rip operand, no branch, and only plain
+// calls. Deciding that needs a disassembler and lives in
+// `tail_call_profile_writer.cc`. This header groups and costs the qualifying
+// blocks, and depends only on the C++ standard library so it can be
+// unit-tested alone.
+//
+// The compiler emits each master from the bytes written into its directive,
+// so a master computes exactly what every copy computed in this binary. It
+// replaces a block, the master's own included, only if the block's
+// instructions have no operand the linker fills in other than the calls'
+// targets, and match the directive's instruction count and callees.
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "propeller/save_and_jump_dedupper.h"
+#include "propeller/tail_call_dedupper.h"
+
+namespace propeller {
+
+// A basic block whose body is a candidate for a Call-Return fold.
+struct CallReturnBlock {
+  std::string module_name;    // Source module ("" if unknown).
+  std::string function_name;  // Function symbol the block belongs to.
+  uint32_t bb_id = 0;         // BB id within the function (matches BBAddrMap).
+  uint64_t address = 0;       // Binary address (used for deterministic order).
+  uint64_t frequency = 0;     // Execution frequency (used for master selection).
+  // The body in position-independent form, which is what groups are formed on:
+  // its machine bytes, except that each direct call's rel32 displacement is
+  // replaced by the call's absolute target (8 bytes, little endian). The same
+  // call bytes at different addresses reach different functions, so they must
+  // not compare equal; the same target reached from different addresses must.
+  std::vector<uint8_t> key;
+  // The offset in `key` of each direct call, whose opcode byte is followed
+  // there by its 8-byte target. Every direct call is a 5-byte `call rel32`.
+  std::vector<uint32_t> call_key_offsets;
+  uint32_t body_size = 0;   // True size of the body in bytes.
+  uint32_t inst_count = 0;  // Number of instructions in the body.
+  // One entry per call in the body, in order: the names of the direct call's
+  // target, alternatives separated by '|', or "*" for an indirect call. Empty
+  // if the body makes no call.
+  std::vector<std::string> callees;
+};
+
+struct CallReturnDedupOptions {
+  // Bytes of a stub for a body without calls: `call rel32`.
+  int stub_size = 5;
+  // Bytes of a stub for a body with calls: `push %rax` (1) + `call rel32` (5) +
+  // `lea 8(%rsp),%rsp` (5).
+  int stub_size_with_calls = 11;
+  // Bytes the master routine adds besides the body: its `ret`.
+  int master_overhead = 1;
+  // Minimum number of identical copies in a group before folding is considered.
+  int min_occurrences = 2;
+  // First value of K used for `DeduBB.master.cr.K` symbol names.
+  uint64_t first_master_id = 0;
+  // If true, only deduplicate blocks that belong to the same module.
+  bool intra_module_only = false;
+};
+
+struct CallReturnDedupResult {
+  // Directives to emit, in deterministic order (by module, function, bb id).
+  std::vector<Directive> directives;
+  // Addresses of every block that becomes a stub (masters included), sorted.
+  std::vector<uint64_t> stub_addresses;
+  int num_groups = 0;             // Number of groups (== number of masters).
+  int num_groups_with_calls = 0;  // Groups whose body makes calls.
+  int num_stubs = 0;              // Blocks that become stubs, masters included.
+  int num_stubs_with_calls = 0;   // Of those, blocks whose body makes calls.
+  // Distinct modules that hold a master. The compiler emits one master
+  // function per module, which costs one unwind table entry (FDE) there.
+  int num_master_modules = 0;
+  int64_t bytes_saved = 0;  // Estimated `.text` reduction in bytes.
+};
+
+// Appends a direct call to a block's key: the call's bytes without its
+// trailing 32-bit displacement, then the absolute `target` (8 bytes, little
+// endian). `size` must be at least 4.
+void AppendDirectCallToKey(std::vector<uint8_t>& key, const uint8_t* call,
+                           size_t size, uint64_t target);
+
+// Runs the DeduBB Call-Return dedup algorithm over `blocks`:
+//   1. bucket blocks by the FNV-1a hash of their key,
+//   2. within a bucket, group blocks with identical keys (byte-by-byte),
+//   3. keep a group if it saves bytes: every member shrinks from its body to a
+//      stub, and the master routine costs the body plus its `ret`:
+//        members * (body - stub) - (body + master_overhead) > 0.
+//      The first block of each group (hottest, then no `.llvm.` suffix, then
+//      lowest address) is the master.
+// The input is not mutated; ordering of the output is deterministic.
+CallReturnDedupResult DeduplicateCallReturnBlocks(
+    const std::vector<CallReturnBlock>& blocks,
+    const CallReturnDedupOptions& options = {});
+
+// Adds `offset` to every master id in `result`, so that the call-return
+// masters can be numbered after the other kinds.
+void OffsetCallReturnMasterIds(CallReturnDedupResult& result, uint64_t offset);
+
+// Returns `blocks` without the blocks at `sorted_addresses`. A block that
+// becomes a call-return stub gets no Save-and-Jump directive.
+std::vector<SaveAndJumpBlock> RemoveBlocksAt(
+    const std::vector<SaveAndJumpBlock>& blocks,
+    const std::vector<uint64_t>& sorted_addresses);
+
+// Formats `result` as the textual directive file consumed by the LLVM CodeGen
+// side:
+//
+//   m <module>
+//   f <function>
+//   bbmcr <id> (DeduBB.master.cr.<K>) callees=<callees> insts=<n> body=<body>
+//   bbfcr <id> (DeduBB.master.cr.<K>) callees=<callees> insts=<n>
+//
+// where <callees> lists the body's calls in order, separated by ',', each one
+// the '|'-separated names of a direct call's target or '*' for an indirect
+// call; it is empty for a body without calls. <n> is the number of
+// instructions in the body. The CodeGen side checks every block's calls and
+// instruction count against these. <body> is the master's body in hex, split
+// by '.' where each direct call goes: the master calls the next direct
+// callee there. `m`/`f` headers are emitted whenever the module/function
+// changes.
+std::string FormatCallReturnDirectives(const CallReturnDedupResult& result);
+
+// Returns `block`'s body as written after `body=`.
+std::string FormatCallReturnBody(const CallReturnBlock& block);
+
+}  // namespace propeller
+
+#endif  // PROPELLER_CALL_RETURN_DEDUPPER_H_
