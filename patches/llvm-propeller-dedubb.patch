+
+// A body of `size` bytes without calls; different `seed`s give different
+// bodies.
+std::vector<uint8_t> Body(int size, uint8_t seed = 0x40) {
+  std::vector<uint8_t> bytes(size);
+  for (int i = 0; i < size; ++i) bytes[i] = static_cast<uint8_t>(seed + i);
+  return bytes;
+}
+
+CallReturnBlock MakeBlock(std::string function, uint32_t id, uint64_t address,
+                          std::vector<uint8_t> key, uint32_t body_size,
+                          std::vector<std::string> callees = {}) {
+  CallReturnBlock block;
+  block.function_name = std::move(function);
+  block.bb_id = id;
+  block.address = address;
+  block.key = std::move(key);
+  block.body_size = body_size;
+  block.callees = std::move(callees);
+  return block;
+}
+
+// `call rel32` at `address` to `target`, as it appears in the binary.
+std::vector<uint8_t> CallBytes(uint64_t address, uint64_t target) {
+  const int32_t rel = static_cast<int32_t>(target - (address + 5));
+  std::vector<uint8_t> bytes = {0xe8};
+  for (int i = 0; i < 4; ++i) bytes.push_back(static_cast<uint8_t>(rel >> (8 * i)));
+  return bytes;
+}
+
+// The key of `prefix; call target`, with the call at `call_address`.
+std::vector<uint8_t> KeyWithCall(const std::vector<uint8_t>& prefix,
+                                 uint64_t call_address, uint64_t target) {
+  std::vector<uint8_t> key = prefix;
+  const std::vector<uint8_t> call = CallBytes(call_address, target);
+  AppendDirectCallToKey(key, call.data(), call.size(), target);
+  return key;
+}
+
+// Calls to the same function from different places have different bytes but
+// the same key; the same bytes at different places call different functions
+// and get different keys.
+TEST(AppendDirectCallToKeyTest, KeyHoldsTheTargetNotTheDisplacement) {
+  const std::vector<uint8_t> prefix = Body(20);
+  EXPECT_NE(CallBytes(0x1000, 0x9000), CallBytes(0x2000, 0x9000));
+  EXPECT_EQ(KeyWithCall(prefix, 0x1000, 0x9000),
+            KeyWithCall(prefix, 0x2000, 0x9000));
+  EXPECT_EQ(CallBytes(0x1000, 0x9000), CallBytes(0x2000, 0xa000));
+  EXPECT_NE(KeyWithCall(prefix, 0x1000, 0x9000),
+            KeyWithCall(prefix, 0x2000, 0xa000));
+}
+
+TEST(DeduplicateCallReturnBlocksTest, GroupsCallsToTheSameTarget) {
+  const std::vector<uint8_t> prefix = Body(20);
+  const std::vector<CallReturnBlock> blocks = {
+      MakeBlock("a", 1, 0x1000, KeyWithCall(prefix, 0x1014, 0x9000), 25,
+                {"f"}),
+      MakeBlock("b", 1, 0x2000, KeyWithCall(prefix, 0x2014, 0x9000), 25,
+                {"f"}),
+      // The same bytes as "a" would have at 0x3000, but they call another
+      // function.
+      MakeBlock("c", 1, 0x3000, KeyWithCall(prefix, 0x3014, 0xa000), 25,
+                {"g"}),
+  };
+  const CallReturnDedupResult result = DeduplicateCallReturnBlocks(blocks);
+  ASSERT_EQ(result.num_groups, 1);
+  EXPECT_EQ(result.num_stubs, 2);
+  EXPECT_EQ(result.num_stubs_with_calls, 2);
+  // 2 * (25 - 11) - (25 + 1) = 2.
+  EXPECT_EQ(result.bytes_saved, 2);
+  for (const Directive& d : result.directives) EXPECT_NE(d.function_name, "c");
+  EXPECT_EQ(result.stub_addresses, (std::vector<uint64_t>{0x1000, 0x2000}));
+}
+
+// Two copies without calls pay off once the body is longer than
+// 2 * 5 + 1 = 11 bytes: 2 * (body - 5) - (body + 1) = body - 11.
+TEST(DeduplicateCallReturnBlocksTest, BodyWithoutCallsThreshold) {
+  for (const int body : {11, 12}) {
+    const std::vector<CallReturnBlock> blocks = {
+        MakeBlock("a", 1, 0x1000, Body(body), body),
+        MakeBlock("b", 1, 0x2000, Body(body), body),
+    };
+    const CallReturnDedupResult result = DeduplicateCallReturnBlocks(blocks);
+    EXPECT_EQ(result.num_groups, body > 11 ? 1 : 0) << body;
+    EXPECT_EQ(result.bytes_saved, body > 11 ? body - 11 : 0) << body;
+  }
+}
+
+// With calls the stub is 11 bytes: two copies need a body of more than
+// 2 * 11 + 1 = 23 bytes.
+TEST(DeduplicateCallReturnBlocksTest, BodyWithCallsThreshold) {
+  for (const int body : {23, 24}) {
+    const std::vector<uint8_t> key = KeyWithCall(Body(body - 5), 0, 0x9000);
+    const std::vector<CallReturnBlock> blocks = {
+        MakeBlock("a", 1, 0x1000, key, body, {"f"}),
+        MakeBlock("b", 1, 0x2000, key, body, {"f"}),
+    };
+    const CallReturnDedupResult result = DeduplicateCallReturnBlocks(blocks);
+    EXPECT_EQ(result.num_groups, body > 23 ? 1 : 0) << body;
+    EXPECT_EQ(result.bytes_saved, body > 23 ? body - 23 : 0) << body;
+  }
+}
+
+// More copies make a short body worth it: 3 * (9 - 5) - (9 + 1) = 2.
+TEST(DeduplicateCallReturnBlocksTest, ChargesTheMasterOnce) {
+  std::vector<CallReturnBlock> blocks;
+  for (int i = 0; i < 3; ++i)
+    blocks.push_back(MakeBlock(std::string(1, static_cast<char>('a' + i)), 1,
+                               0x1000 * (i + 1),
+                               Body(9), 9));
+  const CallReturnDedupResult result = DeduplicateCallReturnBlocks(blocks);
+  ASSERT_EQ(result.num_groups, 1);
+  EXPECT_EQ(result.num_stubs, 3);
+  EXPECT_EQ(result.bytes_saved, 2);
+  // Every copy, the master's own block included, becomes a stub.
+  EXPECT_EQ(result.directives.size(), 3u);
+}
+
+TEST(DeduplicateCallReturnBlocksTest, RespectsIntraModuleOnly) {
+  std::vector<CallReturnBlock> blocks = {
+      MakeBlock("a", 1, 0x1000, Body(30), 30),
+      MakeBlock("b", 1, 0x2000, Body(30), 30),
+  };
+  blocks[0].module_name = "m1";
+  blocks[1].module_name = "m2";
+  CallReturnDedupOptions options;
+  options.intra_module_only = true;
+  EXPECT_EQ(DeduplicateCallReturnBlocks(blocks, options).num_groups, 0);
+  EXPECT_EQ(DeduplicateCallReturnBlocks(blocks).num_groups, 1);
+}
+
+TEST(DeduplicateCallReturnBlocksTest, CountsMasterModules) {
+  std::vector<CallReturnBlock> blocks = {
+      MakeBlock("a", 1, 0x1000, Body(30, 0x10), 30),
+      MakeBlock("b", 1, 0x2000, Body(30, 0x10), 30),
+      MakeBlock("c", 1, 0x3000, Body(30, 0x20), 30),
+      MakeBlock("d", 1, 0x4000, Body(30, 0x20), 30),
+  };
+  blocks[0].module_name = "m1";
+  blocks[1].module_name = "m2";
+  blocks[2].module_name = "m1";
+  blocks[3].module_name = "m2";
+  const CallReturnDedupResult result = DeduplicateCallReturnBlocks(blocks);
+  EXPECT_EQ(result.num_groups, 2);
+  EXPECT_EQ(result.num_master_modules, 1);  // Both masters live in m1.
+}
+
+std::string Hex(const std::vector<uint8_t>& bytes) {
+  static constexpr char kHex[] = "0123456789abcdef";
+  std::string out;
+  for (uint8_t b : bytes) {
+    out += kHex[b >> 4];
+    out += kHex[b & 15];
+  }
+  return out;
+}
+
+// `<prefix>; call target; call *%rax; <suffix>`, as a block's key.
+CallReturnBlock BlockWithCalls(std::string function, uint32_t id,
+                               uint64_t address,
+                               const std::vector<uint8_t>& prefix,
+                               const std::vector<uint8_t>& suffix) {
+  std::vector<uint8_t> key = KeyWithCall(prefix, address, 0x9000);
+  key.insert(key.end(), {0xff, 0xd0});  // call *%rax
+  key.insert(key.end(), suffix.begin(), suffix.end());
+  CallReturnBlock block = MakeBlock(
+      std::move(function), id, address, std::move(key),
+      static_cast<uint32_t>(prefix.size() + 5 + 2 + suffix.size()),
+      {"f|f_alias", "*"});
+  block.call_key_offsets = {static_cast<uint32_t>(prefix.size())};
+  block.inst_count = 9;
+  return block;
+}
+
+// The body is split where each direct call goes; an indirect call stays in
+// the bytes.
+TEST(FormatCallReturnBodyTest, SplitsAtDirectCalls) {
+  const CallReturnBlock block =
+      BlockWithCalls("a", 1, 0x1000, Body(3, 0x40), Body(2, 0x50));
+  EXPECT_EQ(FormatCallReturnBody(block), "404142.ffd05051");
+  EXPECT_EQ(FormatCallReturnBody(MakeBlock("b", 1, 0, Body(3, 0x40), 3)),
+            "404142");
+}
+
+TEST(FormatCallReturnDirectivesTest, EmitsCallReturnDirectives) {
+  std::vector<CallReturnBlock> blocks = {
+      BlockWithCalls("a", 3, 0x1000, Body(30), Body(2, 0x50)),
+      BlockWithCalls("b", 5, 0x2000, Body(30), Body(2, 0x50)),
+      MakeBlock("c", 2, 0x3000, Body(20, 0x70), 20),
+      MakeBlock("d", 4, 0x4000, Body(20, 0x70), 20),
+  };
+  blocks[2].inst_count = blocks[3].inst_count = 6;
+  CallReturnDedupResult result = DeduplicateCallReturnBlocks(blocks);
+  OffsetCallReturnMasterIds(result, 7);
+  EXPECT_EQ(FormatCallReturnDirectives(result),
+            "m \n"
+            "f a\n"
+            "bbmcr 3 (DeduBB.master.cr.7) callees=f|f_alias,* insts=9 body=" +
+                Hex(Body(30)) + ".ffd05051\n"
+            "f b\n"
+            "bbfcr 5 (DeduBB.master.cr.7) callees=f|f_alias,* insts=9\n"
+            "f c\n"
+            "bbmcr 2 (DeduBB.master.cr.8) callees= insts=6 body=" +
+                Hex(Body(20, 0x70)) + "\n"
+            "f d\n"
+            "bbfcr 4 (DeduBB.master.cr.8) callees= insts=6\n");
+}
+
+// Blocks in Call-Return groups are withheld from Save-and-Jump, which then
+// groups the rest.
+TEST(RemoveBlocksAtTest, SaveAndJumpTakesTheRest) {
+  const std::vector<CallReturnBlock> cr_blocks = {
+      MakeBlock("a", 1, 0x1000, Body(30), 30),
+      MakeBlock("b", 1, 0x2000, Body(30), 30),
+  };
+  const CallReturnDedupResult cr = DeduplicateCallReturnBlocks(cr_blocks);
+  ASSERT_EQ(cr.num_groups, 1);
+
+  const auto sj_block = [](std::string function, uint64_t address,
+                           uint8_t seed) {
+    return SaveAndJumpBlock{/*module_name=*/"", std::move(function), 1,
+                            address, /*frequency=*/0, Body(30, seed),
+                            /*jump_size=*/0};
+  };
+  const std::vector<SaveAndJumpBlock> sj_blocks = {
+      sj_block("a", 0x1000, 0x40), sj_block("b", 0x2000, 0x40),
+      // Not Call-Return candidates, say because they read %rsp.
+      sj_block("c", 0x3000, 0x60), sj_block("d", 0x4000, 0x60),
+      sj_block("e", 0x5000, 0x60),
+  };
+  const std::vector<SaveAndJumpBlock> left =
+      RemoveBlocksAt(sj_blocks, cr.stub_addresses);
+  ASSERT_EQ(left.size(), 3u);
+  const SaveAndJumpDedupResult sj = DeduplicateSaveAndJumpBlocks(left);
+  EXPECT_EQ(sj.num_groups, 1);
+  EXPECT_EQ(sj.num_folds, 2);
+  for (const Directive& d : sj.directives) {
+    EXPECT_NE(d.function_name, "a");
+    EXPECT_NE(d.function_name, "b");
+  }
+}
