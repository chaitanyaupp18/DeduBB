+#include "propeller/save_and_jump_dedupper.h"
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "gtest/gtest.h"
+#include "propeller/tail_call_dedupper.h"
+
+namespace propeller {
+namespace {
+
+// A block body of `size` bytes; different `seed`s give different bodies.
+std::vector<uint8_t> Body(int size, uint8_t seed = 0x40) {
+  std::vector<uint8_t> bytes(size);
+  for (int i = 0; i < size; ++i) bytes[i] = static_cast<uint8_t>(seed + i);
+  return bytes;
+}
+
+SaveAndJumpBlock MakeBlock(std::string function, uint32_t id, uint64_t address,
+                           std::vector<uint8_t> body, uint32_t jump_size) {
+  return SaveAndJumpBlock{/*module_name=*/"", std::move(function), id, address,
+                          /*frequency=*/0, std::move(body), jump_size};
+}
+
+// Two 20-byte bodies that fall through: the fold saves 20 - 12 = 8 bytes, but
+// the master grows by 10 (leaq + jmp *%r11), so folding would lose 2 bytes.
+TEST(DeduplicateSaveAndJumpBlocksTest, ChargesMasterOverhead) {
+  const std::vector<SaveAndJumpBlock> blocks = {
+      MakeBlock("a", 1, 0x1000, Body(20), 0),
+      MakeBlock("b", 1, 0x2000, Body(20), 0),
+  };
+  const SaveAndJumpDedupResult result = DeduplicateSaveAndJumpBlocks(blocks);
+  EXPECT_EQ(result.num_groups, 0);
+  EXPECT_TRUE(result.directives.empty());
+}
+
+// A third copy makes it pay: 2 * (20 - 12) - 10 = 6 bytes.
+TEST(DeduplicateSaveAndJumpBlocksTest, FoldsWhenCopiesOutweighMaster) {
+  const std::vector<SaveAndJumpBlock> blocks = {
+      MakeBlock("a", 1, 0x1000, Body(20), 0),
+      MakeBlock("b", 1, 0x2000, Body(20), 0),
+      MakeBlock("c", 1, 0x3000, Body(20), 0),
+  };
+  const SaveAndJumpDedupResult result = DeduplicateSaveAndJumpBlocks(blocks);
+  EXPECT_EQ(result.num_groups, 1);
+  EXPECT_EQ(result.num_folds, 2);
+  EXPECT_EQ(result.bytes_saved, 6);
+}
+
+// Bodies match even though the copies jump to different successors (the
+// trailing `jmp` is not part of `bytes`), and the stripped jumps are credited.
+TEST(DeduplicateSaveAndJumpBlocksTest, IgnoresTrailingJumpWhenMatching) {
+  const std::vector<SaveAndJumpBlock> blocks = {
+      MakeBlock("a", 4, 0x1000, Body(16), /*jump_size=*/5),
+      MakeBlock("b", 7, 0x2000, Body(16), /*jump_size=*/2),
+  };
+  // Fold: 16 + 2 - 12 = 6. Master grows by 10 - 5 = 5. Net: 1.
+  const SaveAndJumpDedupResult result = DeduplicateSaveAndJumpBlocks(blocks);
+  ASSERT_EQ(result.num_groups, 1);
+  EXPECT_EQ(result.bytes_saved, 1);
+  ASSERT_EQ(result.directives.size(), 2u);
+  EXPECT_EQ(result.directives[0].kind, DirectiveKind::kMasterSaveJump);
+  EXPECT_EQ(result.directives[0].function_name, "a");
+  EXPECT_EQ(result.directives[1].kind, DirectiveKind::kFoldSaveJump);
+  EXPECT_EQ(result.directives[1].function_name, "b");
+  EXPECT_EQ(result.directives[0].master_id, result.directives[1].master_id);
+}
+
+// A copy that would grow is left alone while the rest of the group folds.
+TEST(DeduplicateSaveAndJumpBlocksTest, SkipsCopiesThatWouldGrow) {
+  const std::vector<SaveAndJumpBlock> blocks = {
+      MakeBlock("a", 1, 0x1000, Body(11), 5),  // master: grows by 10 - 5 = 5
+      MakeBlock("b", 1, 0x2000, Body(11), 5),  // 11 + 5 - 12 = 4
+      MakeBlock("c", 1, 0x3000, Body(11), 0),  // 11 + 0 - 12 = -1: not folded
+      MakeBlock("d", 1, 0x4000, Body(11), 5),  // 4
+  };
+  const SaveAndJumpDedupResult result = DeduplicateSaveAndJumpBlocks(blocks);
+  ASSERT_EQ(result.num_groups, 1);
+  EXPECT_EQ(result.num_folds, 2);
+  EXPECT_EQ(result.bytes_saved, 3);
+  for (const Directive& d : result.directives) EXPECT_NE(d.function_name, "c");
+}
+
+TEST(DeduplicateSaveAndJumpBlocksTest, DoesNotFoldDifferentBodies) {
+  const std::vector<SaveAndJumpBlock> blocks = {
+      MakeBlock("a", 1, 0x1000, Body(40, 0x10), 0),
+      MakeBlock("b", 1, 0x2000, Body(40, 0x20), 0),
+      MakeBlock("c", 1, 0x3000, Body(40, 0x30), 0),
+  };
+  EXPECT_EQ(DeduplicateSaveAndJumpBlocks(blocks).num_groups, 0);
+}
+
+TEST(FormatSaveAndJumpDirectivesTest, EmitsSaveAndJumpDirectives) {
+  const std::vector<SaveAndJumpBlock> blocks = {
+      MakeBlock("a", 3, 0x1000, Body(30), 0),
+      MakeBlock("b", 5, 0x2000, Body(30), 0),
+  };
+  SaveAndJumpDedupOptions options;
+  options.first_master_id = 7;
+  EXPECT_EQ(
+      FormatSaveAndJumpDirectives(DeduplicateSaveAndJumpBlocks(blocks, options)),
+      "m \n"
+      "f a\n"
+      "bbmsj 3 (DeduBB.master.sj.7)\n"
+      "f b\n"
+      "bbfsj 5 (DeduBB.master.sj.7)\n");
+}
+
+SaveAndJumpBlock MakeTwoExitBlock(std::string function, uint32_t id,
+                                  uint64_t address, std::vector<uint8_t> body,
+                                  uint32_t jump_size, int condition) {
+  return SaveAndJumpBlock{/*module_name=*/"", std::move(function), id, address,
+                          /*frequency=*/0, std::move(body), jump_size,
+                          condition};
+}
+
+SaveAndJumpDedupOptions TwoExitOptions() {
+  SaveAndJumpDedupOptions options;
+  options.patch_size = 19;
+  options.master_overhead = 22;
+  options.two_exit = true;
+  return options;
+}
+
+// Two-exit copies match only when they also branch on the same condition.
+TEST(DeduplicateSaveAndJumpBlocksTest, TwoExitBlocksMatchOnCondition) {
+  const std::vector<SaveAndJumpBlock> blocks = {
+      // Master: grows by 22 - 2 = 20.
+      MakeTwoExitBlock("a", 1, 0x1000, Body(40), 2, /*condition=*/4),
+      // Fold: 40 + 2 - 19 = 23.
+      MakeTwoExitBlock("b", 1, 0x2000, Body(40), 2, /*condition=*/4),
+      // Same body, other condition: not a copy of the others.
+      MakeTwoExitBlock("c", 1, 0x3000, Body(40), 2, /*condition=*/5),
+  };
+  const SaveAndJumpDedupResult result =
+      DeduplicateSaveAndJumpBlocks(blocks, TwoExitOptions());
+  ASSERT_EQ(result.num_groups, 1);
+  EXPECT_EQ(result.num_folds, 1);
+  EXPECT_EQ(result.bytes_saved, 3);
+  for (const Directive& d : result.directives) EXPECT_NE(d.function_name, "c");
+}
+
+TEST(FormatSaveAndJumpDirectivesTest, EmitsTwoExitDirectives) {
+  const std::vector<SaveAndJumpBlock> blocks = {
+      MakeTwoExitBlock("a", 3, 0x1000, Body(40), 6, 4),
+      MakeTwoExitBlock("b", 5, 0x2000, Body(40), 6, 4),
+  };
+  SaveAndJumpDedupOptions options = TwoExitOptions();
+  options.first_master_id = 9;
+  // Fold: 40 + 6 - 19 = 27. Master grows by 22 - 6 = 16. Net: 11.
+  const SaveAndJumpDedupResult result =
+      DeduplicateSaveAndJumpBlocks(blocks, options);
+  EXPECT_EQ(result.bytes_saved, 11);
+  EXPECT_EQ(FormatSaveAndJumpDirectives(result),
+            "m \n"
+            "f a\n"
+            "bbmsj2 3 (DeduBB.master.sj2.9)\n"
+            "f b\n"
+            "bbfsj2 5 (DeduBB.master.sj2.9)\n");
+}
+
