+
+#ifndef PROPELLER_TAIL_CALL_PROFILE_WRITER_H_
+#define PROPELLER_TAIL_CALL_PROFILE_WRITER_H_
+
+// Binary-facing glue for DeduBB basic-block deduplication ("Step 1").
+//
+// `WriteTailCallDedupProfile` reads the basic blocks of `opts.binary_name()`
+// from its `SHT_LLVM_BB_ADDR_MAP` section, extracts the raw machine bytes of
+// the candidate blocks, runs the FNV-1a + byte-by-byte deduplication (see
+// `tail_call_dedupper.h`, `save_and_jump_dedupper.h` and
+// `call_return_dedupper.h`), and writes the resulting
+// `m`/`f`/`bbm`/`bbf`/`bbmsj`/`bbfsj`/`bbmsj2`/`bbfsj2` directives, and with
+// `opts.dedubb_call_return()` also `bbmcr`/`bbfcr`, to
+// `opts.dedubb_profile_out_name()`.
+//
+// This is a static analysis of the binary: it does not require a perf profile.
+// A profile is only consulted when `opts.dedubb_cold_only()` is set, to
+// restrict folding to cold blocks.
+
+#include <vector>
+
+#include "absl/status/status.h"
+#include "propeller/bb_addr_map.pb.h"
+#include "propeller/binary_content.h"
+#include "propeller/propeller_options.pb.h"
+#include "propeller/tail_call_dedupper.h"
+
+namespace propeller {
+
+// Builds the deduplication candidate blocks (those ending in a tail call or
+// return) from a decoded `BbAddrMapPb`, slicing their raw bytes out of
+// `binary_content`. Exposed for testing. If `cold_only` is true, blocks with a
+// non-zero post-link frequency are skipped.
+std::vector<TailCallBlock> BuildTailCallBlocks(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    bool cold_only, bool skip_aliased_functions);
+
+// Returns true if more than one symbol name points at `function`: an alias, or
+// functions merged by identical code folding. DeduBB leaves such functions
+// alone by default (`dedubb_skip_aliased_functions`): changing one of the
+// merged copies would stop the linker from merging them again.
+bool IsAliased(const FunctionBbAddrMapPb& function);
+
+// Returns the size in bytes of the jump used to patch a folded block on the
+// binary's architecture (x86: 5, AArch64/ARM: 4).
+int TailCallPatchSize(const BinaryContent& binary_content);
+
+// Runs DeduBB deduplication on `opts.binary_name()` and writes the directive
+// file to `opts.dedubb_profile_out_name()`. A no-op (returns OK) if
+// `dedubb_profile_out_name` is empty.
+absl::Status WriteTailCallDedupProfile(const PropellerOptions& opts);
+
+}  // namespace propeller
+
+#endif  // PROPELLER_TAIL_CALL_PROFILE_WRITER_H_
diff --git a/propeller/save_and_jump_dedupper.h b/propeller/save_and_jump_dedupper.h
new file mode 100644
index 0000000..e826503
--- /dev/null
+++ b/propeller/save_and_jump_dedupper.h
@@ -0,0 +1,129 @@
+// Copyright 2026 The Propeller Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef PROPELLER_SAVE_AND_JUMP_DEDUPPER_H_
+#define PROPELLER_SAVE_AND_JUMP_DEDUPPER_H_
+
+#include "propeller/tail_call_dedupper.h"
+
+// DeduBB Save-and-Jump (Case III) deduplication core (LCTES'26).
+//
+// Folds byte-identical straight-line blocks that have exactly one successor.
+// On x86-64 every folded copy becomes
+//
+//   leaq Succ(%rip), %r11 ; jmp DeduBB.master.sj.K
+//
+// and the master ends in `jmp *%r11`, so each copy continues at its *own*
+// successor. That is why only the block body has to match: the trailing direct
+// `jmp` of a block (if any) is stripped before hashing and comparing, and its
+// size is kept separately because folding removes it too.
+//
+// Two-exit blocks end in a conditional branch. Their folds load both successors
+//
+//   leaq Taken(%rip), %r11 ; leaq NotTaken(%rip), %r10 ; jmp DeduBB.master.sj2.K
+//
+// and the master ends in `j<cc> 1f; jmp *%r10; 1: jmp *%r11`. The branches are
+// stripped as well; copies match when their bodies and branch conditions do.
+//
+// Deciding which blocks qualify (one successor, no calls, no %r11 use, no
+// PC-relative operands, no %rsp change) needs a disassembler and lives in
+// `tail_call_profile_writer.cc`. This header only groups and costs them, and
+// depends only on the C++ standard library so it can be unit-tested alone.
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace propeller {
+
+// 64-bit FNV-1a hash (Fowler-Noll-Vo, Noll). Used as the fast bucket key before
+// the byte-by-byte verification.
+uint64_t Fnv1aHash(const uint8_t* data, size_t size);
+uint64_t Fnv1aHash(const std::vector<uint8_t>& bytes);
+
+// A basic block that is a candidate for save-and-jump deduplication.
+struct SaveAndJumpBlock {
+  std::string module_name;     // Source module ("" if unknown).
+  std::string function_name;   // Function symbol the block belongs to.
+  uint32_t bb_id = 0;          // BB id within the function (matches BBAddrMap).
+  uint64_t address = 0;        // Binary address (used for deterministic order).
+  uint64_t frequency = 0;      // Execution frequency (used for master selection).
+  std::vector<uint8_t> bytes;  // Machine bytes of the block body, i.e. without
+                               // its trailing branches.
+  uint32_t jump_size = 0;      // Size of the stripped branches: the trailing
+                               // `jmp` (0 if the block falls through), plus the
+                               // conditional branch of a two-exit block.
+  int condition = -1;          // Condition code of a two-exit block's
+                               // conditional branch; -1 for a single exit.
+};
+
+struct SaveAndJumpDedupOptions {
+  // Bytes of a folded copy: x86-64 `leaq Succ(%rip),%r11` (7) + `jmp` (5).
+  int patch_size = 12;
+  // Bytes the master's own block grows by: the `leaq Succ(%rip),%r11` placed in
+  // front of it (7) plus its `jmp *%r11` (3). The master's own trailing `jmp`,
+  // if any, is replaced by the `jmp *%r11` and is credited back.
+  int master_overhead = 10;
+  // Minimum number of identical copies in a group before folding is considered.
+  int min_occurrences = 2;
+  // First value of K used for `DeduBB.master.sj.K` symbol names. Any unique
+  // numbering works; the CodeGen side only relies on master/fold lines of the
+  // same group sharing the same K.
+  uint64_t first_master_id = 0;
+  // If true, only deduplicate blocks that belong to the same module.
+  bool intra_module_only = false;
+  // If true, the blocks are two-exit blocks: emit `bbmsj2`/`bbfsj2`
+  // (DeduBB.master.sj2.K). Callers also set `patch_size` to 19 (two `leaq` + a
+  // `jmp`) and `master_overhead` to 22 (two `leaq` in front of the master, plus
+  // `j<cc> 1f; jmp *%r10; 1: jmp *%r11`).
+  bool two_exit = false;
+};
+
+struct SaveAndJumpDedupResult {
+  // Directives to emit, in deterministic order (by module, function, bb id).
+  std::vector<Directive> directives;
+  int num_groups = 0;       // Number of master groups (folded).
+  int num_masters = 0;      // Number of `bbmsj` directives (== num_groups).
+  int num_folds = 0;        // Number of `bbfsj` directives.
+  int64_t bytes_saved = 0;  // Estimated `.text` reduction in bytes.
+};
+
+// Runs the DeduBB Save-and-Jump dedup algorithm over `blocks`:
+//   1. bucket blocks by FNV-1a hash of their body bytes,
+//   2. within a bucket, group blocks with *identical* bodies (byte-by-byte)
+//      and branch conditions,
+//   3. keep the first block of each group (hottest, then lowest address) as the
+//      master and fold every other copy whose own saving
+//      `body + jump_size - patch_size` is positive; keep the group only if the
+//      folds save more than the master grows (`master_overhead - jump_size`).
+// The input is not mutated; ordering of the output is deterministic.
+SaveAndJumpDedupResult DeduplicateSaveAndJumpBlocks(
+    const std::vector<SaveAndJumpBlock>& blocks,
+    const SaveAndJumpDedupOptions& options = {});
+
+// Formats `result` as the textual directive file consumed by the LLVM CodeGen
+// side:
+//
+//   m <module>
+//   f <function>
+//   bbmsj <id> (DeduBB.master.sj.<K>)     bbmsj2 <id> (DeduBB.master.sj2.<K>)
+//   bbfsj <id> (DeduBB.master.sj.<K>)     bbfsj2 <id> (DeduBB.master.sj2.<K>)
+//
+// `m`/`f` headers are emitted whenever the module/function changes.
+std::string FormatSaveAndJumpDirectives(const SaveAndJumpDedupResult& result);
+
+}  // namespace propeller
+
+#endif  // PROPELLER_SAVE_AND_JUMP_DEDUPPER_H_
diff --git a/propeller/save_and_jump_dedupper.cc b/propeller/save_and_jump_dedupper.cc
new file mode 100644
index 0000000..3925c54
--- /dev/null
+++ b/propeller/save_and_jump_dedupper.cc
@@ -0,0 +1,213 @@
+// Copyright 2026 The Propeller Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "propeller/save_and_jump_dedupper.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace propeller {
+
+
+
+namespace {
+
+// A set of blocks (referenced by index into the caller's `blocks` vector) whose
+// body bytes are all identical. The first element (in `BlockOrderLess` order)
+// is the master copy.
+struct IdenticalGroup {
+  std::vector<int> members;  // indices into `blocks`, in `BlockOrderLess` order
+};
+
+// A group that is worth folding: its master and the copies that shrink.
+struct FoldPlan {
+  int master = 0;          // index into `blocks`
+  std::vector<int> folds;  // indices into `blocks`
+  int64_t benefit = 0;     // net `.text` bytes saved by the whole group
+};
+
+// Orders blocks deterministically; the hottest is promoted to the master.
+// We prioritize functions that do not have a ThinLTO ".llvm." suffix,
+// so that the master block is placed in a stable symbol name.
+bool BlockOrderLess(const SaveAndJumpBlock& a, const SaveAndJumpBlock& b) {
+  if (a.frequency != b.frequency) {
+    return a.frequency > b.frequency;
+  }
+  bool a_has_llvm = a.function_name.find(".llvm.") != std::string::npos;
+  bool b_has_llvm = b.function_name.find(".llvm.") != std::string::npos;
+  if (a_has_llvm != b_has_llvm) {
+    return !a_has_llvm;  // prefer a if it does NOT have .llvm.
+  }
+  return std::tie(a.address, a.module_name, a.function_name, a.bb_id) <
+         std::tie(b.address, b.module_name, b.function_name, b.bb_id);
+}
+
+// Orders directives for output: grouped by module, then function, then bb id.
+bool DirectiveOrderLess(const Directive& a, const Directive& b) {
+  return std::tie(a.module_name, a.function_name, a.bb_id) <
+         std::tie(b.module_name, b.function_name, b.bb_id);
+}
+
+}  // namespace
+
+SaveAndJumpDedupResult DeduplicateSaveAndJumpBlocks(
+    const std::vector<SaveAndJumpBlock>& blocks,
+    const SaveAndJumpDedupOptions& options) {
+  SaveAndJumpDedupResult result;
+
+  // Process blocks in a deterministic order so master selection (first in a
+  // group) and master-id assignment are reproducible.
+  std::vector<int> order(blocks.size());
+  for (int i = 0; i < static_cast<int>(blocks.size()); ++i) order[i] = i;
+  std::sort(order.begin(), order.end(), [&](int x, int y) {
+    return BlockOrderLess(blocks[x], blocks[y]);
+  });
+
+  // Bucket by FNV-1a hash of the body, then split each bucket into
+  // byte-identical groups. The hash is only a fast filter; group membership is
+  // decided by an exact byte-by-byte comparison, which rules out collisions.
+  std::unordered_map<uint64_t, std::vector<IdenticalGroup>> buckets;
+  for (int idx : order) {
+    const SaveAndJumpBlock& block = blocks[idx];
+    if (block.bytes.empty()) continue;
+    uint64_t hash = Fnv1aHash(block.bytes);
+    std::vector<IdenticalGroup>& bucket = buckets[hash];
+
+    IdenticalGroup* match = nullptr;
+    for (IdenticalGroup& group : bucket) {
+      // Verify against the group's representative (master) byte-for-byte; a
+      // two-exit block must also branch on the same condition.
+      const SaveAndJumpBlock& rep = blocks[group.members.front()];
+      if (rep.bytes == block.bytes && rep.condition == block.condition) {
+        if (!options.intra_module_only ||
+            rep.module_name == block.module_name) {
+          match = &group;
+          break;
+        }
+      }
+    }
+    if (match == nullptr) {
+      bucket.push_back(IdenticalGroup{{idx}});
+    } else {
+      match->members.push_back(idx);
+    }
+  }
+
+  // Cost each group. The master grows by `master_overhead` minus its own
+  // trailing `jmp` (which its `jmp *%r11` replaces); each folded copy shrinks
+  // from `body + jump_size` to `patch_size`. Copies that would grow are left
+  // alone, and a group is kept only if it saves bytes overall.
+  std::vector<FoldPlan> plans;
+  for (auto& [hash, bucket] : buckets) {
+    for (const IdenticalGroup& group : bucket) {
+      if (static_cast<int>(group.members.size()) < options.min_occurrences)
+        continue;
+      const SaveAndJumpBlock& master = blocks[group.members.front()];
+      const int64_t body = static_cast<int64_t>(master.bytes.size());
+      FoldPlan plan;
+      plan.master = group.members.front();
+      plan.benefit = -(options.master_overhead -
+                       static_cast<int64_t>(master.jump_size));
+      for (size_t i = 1; i < group.members.size(); ++i) {
+        const int64_t saving = body + blocks[group.members[i]].jump_size -
+                               options.patch_size;
+        if (saving <= 0) continue;
+        plan.folds.push_back(group.members[i]);
+        plan.benefit += saving;
+      }
+      if (static_cast<int>(plan.folds.size()) + 1 < options.min_occurrences ||
+          plan.benefit <= 0)
+        continue;
+      plans.push_back(std::move(plan));
+    }
+  }
+  // Sort by the master block so master ids are stable.
+  std::sort(plans.begin(), plans.end(),
+            [&](const FoldPlan& x, const FoldPlan& y) {
+              return BlockOrderLess(blocks[x.master], blocks[y.master]);
+            });
+
+  // Emit directives and tally stats.
+  const DirectiveKind master_kind = options.two_exit
+                                        ? DirectiveKind::kMasterSaveJump2
+                                        : DirectiveKind::kMasterSaveJump;
+  const DirectiveKind fold_kind = options.two_exit
+                                      ? DirectiveKind::kFoldSaveJump2
+                                      : DirectiveKind::kFoldSaveJump;
+  uint64_t master_id = options.first_master_id;
+  for (const FoldPlan& plan : plans) {
+    const SaveAndJumpBlock& master = blocks[plan.master];
+    result.directives.push_back(Directive{master_kind, master.module_name,
+                                          master.function_name, master.bb_id,
+                                          master_id});
+    for (int idx : plan.folds) {
+      const SaveAndJumpBlock& fold = blocks[idx];
+      result.directives.push_back(Directive{fold_kind, fold.module_name,
+                                            fold.function_name, fold.bb_id,
+                                            master_id});
+    }
+
+    ++result.num_groups;
+    ++result.num_masters;
+    result.num_folds += static_cast<int>(plan.folds.size());
+    result.bytes_saved += plan.benefit;
+    ++master_id;
+  }
+
+  std::sort(result.directives.begin(), result.directives.end(),
+            DirectiveOrderLess);
+  return result;
+}
+
+std::string FormatSaveAndJumpDirectives(const SaveAndJumpDedupResult& result) {
+  std::string out;
+  const std::string* cur_module = nullptr;
+  const std::string* cur_function = nullptr;
+  for (const Directive& d : result.directives) {
+    if (cur_module == nullptr || *cur_module != d.module_name) {
+      out += "m ";
+      out += d.module_name;
+      out += "\n";
+      cur_module = &d.module_name;
+      cur_function = nullptr;  // force re-emitting the function header
+    }
+    if (cur_function == nullptr || *cur_function != d.function_name) {
+      out += "f ";
+      out += d.function_name;
+      out += "\n";
+      cur_function = &d.function_name;
+    }
+    const bool two_exit = d.kind == DirectiveKind::kMasterSaveJump2 ||
+                          d.kind == DirectiveKind::kFoldSaveJump2;
+    if (d.kind == DirectiveKind::kMaster) out += "bbm ";
+    else if (d.kind == DirectiveKind::kFold) out += "bbf ";
+    else if (d.kind == DirectiveKind::kMasterSaveJump) out += "bbmsj ";
+    else if (d.kind == DirectiveKind::kFoldSaveJump) out += "bbfsj ";
+    else if (d.kind == DirectiveKind::kMasterSaveJump2) out += "bbmsj2 ";
+    else if (d.kind == DirectiveKind::kFoldSaveJump2) out += "bbfsj2 ";
+    out += std::to_string(d.bb_id);
+    out += two_exit ? " (DeduBB.master.sj2." : " (DeduBB.master.sj.";
+    out += std::to_string(d.master_id);
+    out += ")\n";
+  }
+  return out;
+}
+
+}  // namespace propeller
